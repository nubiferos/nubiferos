    def _create_status_row(self, label_text, status, tooltip=None):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.get_style_context().add_class("status-row")

        label = Gtk.Label(label=label_text)
        label.get_style_context().add_class("status-label")
        label.set_halign(Gtk.Align.START)
        if tooltip:
            label.set_tooltip_text(tooltip)
        row.pack_start(label, True, True, 0)

        if isinstance(status, tuple):
            status_type, status_text = status
        elif status is True:
            status_type, status_text = "ok", "Active"
        elif status is False:
            status_type, status_text = "error", "Inactive"
        else:
            status_type, status_text = "info", str(status)

        status_label = Gtk.Label(label=status_text)
        status_label.get_style_context().add_class(f"status-{status_type}")
        status_label.set_halign(Gtk.Align.END)
        if tooltip:
            status_label.set_tooltip_text(tooltip)
        row.pack_end(status_label, False, False, 0)

        # Info button on the far right, after the status value
        if tooltip:
            info_btn = Gtk.Button(label="ℹ")
            info_btn.get_style_context().add_class("info-button")
            info_btn.set_tooltip_text(tooltip)
            info_btn.set_relief(Gtk.ReliefStyle.NONE)
            info_btn.set_can_focus(False)
            row.pack_end(info_btn, False, False, 0)

        return row
    
