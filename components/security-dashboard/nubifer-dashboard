    def _find_scan_script(self):
        """Locate the nubifer-security-scan script."""
        scan_script = "/usr/local/bin/nubifer-security-scan"
        if os.path.exists(scan_script):
            return scan_script
        scan_script = str(Path(__file__).parent.parent / "scripts" / "nubifer-security-scan")
        if os.path.exists(scan_script):
            return scan_script
        return None

    def _on_run_vuln_scan(self, button):
        """Run grype vulnerability scan independently."""
        if self._vuln_scan_running:
            return
        self._vuln_scan_running = True
        button.set_sensitive(False)
        if self._vuln_status_label:
            self._vuln_status_label.set_text("⏳ Scanning...")
        thread = threading.Thread(target=self._run_vuln_scan_thread, args=(button,))
        thread.daemon = True
        thread.start()

    def _run_vuln_scan_thread(self, button):
        """Background thread for grype vulnerability scan."""
        try:
            scan_script = self._find_scan_script()
            if not scan_script:
                GLib.idle_add(self._vuln_scan_complete, button, False, "Scan script not found")
                return
            result = subprocess.run(
                [scan_script, "--vuln-scan"],
                capture_output=True,
                text=True,
                timeout=600
            )
            success = result.returncode in (0, 2)
            error_msg = None
            if not success:
                if "grype" in result.stderr.lower() or "not found" in result.stderr.lower():
                    error_msg = "grype not installed"
                elif result.stderr:
                    error_msg = result.stderr[:100]
                else:
                    error_msg = f"Exit code {result.returncode}"
            GLib.idle_add(self._vuln_scan_complete, button, success, error_msg)
        except subprocess.TimeoutExpired:
            GLib.idle_add(self._vuln_scan_complete, button, False, "Scan timed out")
        except Exception as e:
            GLib.idle_add(self._vuln_scan_complete, button, False, str(e))

    def _vuln_scan_complete(self, button, success, error=None):
        """Called when vuln scan completes."""
        self._vuln_scan_running = False
        button.set_sensitive(True)
        if success:
            if self._vuln_status_label:
                self._vuln_status_label.set_text("✓ Scan complete")
            GLib.timeout_add(1000, self._delayed_refresh)
        else:
            if self._vuln_status_label and error:
                err_text = error[:30] + "..." if len(error) > 30 else error
                self._vuln_status_label.set_text(f"✗ {err_text}")
                self._vuln_status_label.set_tooltip_text(f"Scan failed: {error}")
            elif self._vuln_status_label:
                self._vuln_status_label.set_text("✗ Scan failed")
        return False

