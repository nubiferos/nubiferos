    def _create_score_section(self):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        box.get_style_context().add_class("score-box")

        # Calculate score
        score, details = self._calculate_security_score()

        # Score display
        score_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        score_box.set_valign(Gtk.Align.CENTER)

        score_label = Gtk.Label(label=str(score))
        score_label.get_style_context().add_class("score-label")
        score_box.pack_start(score_label, False, False, 0)

        score_text = Gtk.Label(label="Security Score")
        score_text.get_style_context().add_class("score-text")
        score_box.pack_start(score_text, False, False, 0)

        box.pack_start(score_box, False, False, 12)

        # Score breakdown as 2x3 grid
        grid = Gtk.Grid()
        grid.get_style_context().add_class("score-grid")
        grid.set_column_spacing(16)
        grid.set_row_spacing(2)
        grid.set_valign(Gtk.Align.CENTER)

        items = list(details.items())
        for i, (item, status) in enumerate(items):
            col = i % 2
            row_idx = i // 2

            cell = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)

            if status:
                icon = Gtk.Label(label="✓")
                icon.get_style_context().add_class("status-ok")
            else:
                icon = Gtk.Label(label="✗")
                icon.get_style_context().add_class("status-error")

            cell.pack_start(icon, False, False, 0)

            label = Gtk.Label(label=item)
            label.get_style_context().add_class("status-label")
            tooltip = self.TOOLTIPS.get(item)
            if tooltip:
                label.set_tooltip_text(tooltip)
                icon.set_tooltip_text(tooltip)
            cell.pack_start(label, False, False, 0)

            grid.attach(cell, col, row_idx, 1, 1)

        box.pack_start(grid, False, False, 0)
        
        return box
    
