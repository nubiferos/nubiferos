    def _populate_vuln_details(self, vuln_data):
        """Populate the vulnerability details box with top CVEs."""
        if not self._vuln_details_box:
            return
        
        # Clear existing
        for child in self._vuln_details_box.get_children():
            child.destroy()
        
        vulns = vuln_data.get("vulnerabilities", [])
        if not vulns:
            return
        
        # Sort by severity (Critical > High > Medium)
        severity_order = {"Critical": 0, "High": 1, "Medium": 2, "Low": 3, "Negligible": 4}
        sorted_vulns = sorted(
            vulns,
            key=lambda v: severity_order.get(v.get("vulnerability", {}).get("severity", "Low"), 5)
        )
        
        # Show top 10
        for vuln in sorted_vulns[:10]:
            vuln_info = vuln.get("vulnerability", {})
            artifact = vuln.get("artifact", {})
            
            severity = vuln_info.get("severity", "Unknown")
            cve_id = vuln_info.get("id", "Unknown")
            package = artifact.get("name", "Unknown")
            version = artifact.get("version", "")
            fixed_in = vuln_info.get("fix", {}).get("versions", [])
            
            # Create vulnerability row
            row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            
            if severity == "Critical":
                row.get_style_context().add_class("vuln-critical")
            elif severity == "High":
                row.get_style_context().add_class("vuln-high")
            else:
                row.get_style_context().add_class("vuln-medium")
            
            # Top line: CVE ID and severity
            top_line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            
            cve_label = Gtk.Label(label=cve_id)
            cve_label.get_style_context().add_class("vuln-id")
            cve_label.set_halign(Gtk.Align.START)
            top_line.pack_start(cve_label, True, True, 0)
            
            sev_label = Gtk.Label(label=severity.upper())
            sev_label.get_style_context().add_class(f"vuln-severity-{severity.lower()}")
            top_line.pack_end(sev_label, False, False, 0)
            
            row.pack_start(top_line, False, False, 0)
            
            # Bottom line: Package info
            pkg_text = f"{package}"
            if version:
                pkg_text += f" ({version})"
            if fixed_in:
                pkg_text += f" → fix: {', '.join(fixed_in[:2])}"
            
            pkg_label = Gtk.Label(label=pkg_text)
            pkg_label.get_style_context().add_class("vuln-package")
            pkg_label.set_halign(Gtk.Align.START)
            pkg_label.set_ellipsize(Pango.EllipsizeMode.END)
            row.pack_start(pkg_label, False, False, 0)
            
            self._vuln_details_box.pack_start(row, False, False, 0)
        
        self._vuln_details_box.show_all()
    
