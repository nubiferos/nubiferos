    def _format_scan_time(self, timestamp_str):
        """Format timestamp as relative time."""
        try:
            scan_time = datetime.fromisoformat(timestamp_str)
            now = datetime.now()
            delta = now - scan_time
            
            if delta < timedelta(minutes=1):
                return "just now"
            elif delta < timedelta(hours=1):
                mins = int(delta.total_seconds() / 60)
                return f"{mins} min ago"
            elif delta < timedelta(days=1):
                hours = int(delta.total_seconds() / 3600)
                return f"{hours} hour{'s' if hours > 1 else ''} ago"
            elif delta < timedelta(days=7):
                days = delta.days
                return f"{days} day{'s' if days > 1 else ''} ago"
            else:
                return scan_time.strftime("%Y-%m-%d")
        except:
            return timestamp_str
    
    def _on_run_scan(self, button):
        """Run security scans in background thread."""
        if self._scan_running:
            return
        
        self._scan_running = True
        button.set_sensitive(False)
        
        if self._scan_status_label:
            self._scan_status_label.set_text("⏳ Scanning...")
        
        # Run scan in background
        thread = threading.Thread(target=self._run_scan_thread, args=(button,))
        thread.daemon = True
        thread.start()
    
    def _run_scan_thread(self, button):
        """Background thread to run security scans."""
        try:
            # Check if scan script exists
            scan_script = "/usr/local/bin/nubifer-security-scan"
            if not os.path.exists(scan_script):
                # Try local path
                scan_script = str(Path(__file__).parent.parent / "scripts" / "nubifer-security-scan")
                if not os.path.exists(scan_script):
                    GLib.idle_add(self._scan_complete, button, False, "Scan script not found")
                    return
            
            # Run the security scan script (without --quiet so we can see errors)
            result = subprocess.run(
                [scan_script, "--full"],
                capture_output=True,
                text=True,
                timeout=600  # 10 minute timeout
            )
            
            # Exit code 0 = success, exit code 2 = critical vulns found (still success)
            success = result.returncode in (0, 2)
            error_msg = None
            critical_found = result.returncode == 2

            if not success:
                # Check for common issues
                if "grype" in result.stderr.lower() or "not found" in result.stderr.lower():
                    error_msg = "grype not installed"
                elif "lynis" in result.stderr.lower():
                    error_msg = "lynis not installed"
                elif result.stderr:
                    error_msg = result.stderr[:100]
                else:
                    error_msg = f"Exit code {result.returncode}"
            
            # Update UI on main thread
            GLib.idle_add(self._scan_complete, button, success, error_msg, critical_found)
        except subprocess.TimeoutExpired:
            GLib.idle_add(self._scan_complete, button, False, "Scan timed out", False)
        except Exception as e:
            GLib.idle_add(self._scan_complete, button, False, str(e), False)
    
    def _scan_complete(self, button, success, error=None, critical_found=False):
        """Called when scan completes - update UI."""
        self._scan_running = False
        button.set_sensitive(True)

        if success:
            if self._scan_status_label:
                if critical_found:
                    self._scan_status_label.set_text("⚠ Critical vulns found")
                else:
                    self._scan_status_label.set_text("✓ Scan complete")
            # Refresh the window to show new results
            GLib.timeout_add(1000, self._delayed_refresh)
        else:
            if self._scan_status_label:
                if error:
                    # Show truncated error
                    err_text = error[:30] + "..." if len(error) > 30 else error
                    self._scan_status_label.set_text(f"✗ {err_text}")
                    self._scan_status_label.set_tooltip_text(f"Scan failed: {error}")
                else:
                    self._scan_status_label.set_text("✗ Scan failed")
        
        return False
    
    def _delayed_refresh(self):
        """Refresh after a short delay."""
        self._on_refresh(None)
        return False
    
    def _on_refresh(self, button):
        # Rebuild the window
        for child in self.get_children():
            child.destroy()
        self.__init__()


