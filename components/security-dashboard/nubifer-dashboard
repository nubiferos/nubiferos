    def _on_view_vuln_log(self, button):
        """Open vuln-scan.json with xdg-open."""
        log_path = self.SCAN_RESULTS_DIR / "vuln-scan.json"
        if not log_path.exists():
            button.set_tooltip_text("No scan results yet — run a scan first")
            return
        subprocess.Popen(["xdg-open", str(log_path)])

    def _on_view_compliance_log(self, button):
        """Open compliance.json with xdg-open."""
        log_path = self.SCAN_RESULTS_DIR / "compliance.json"
        if not log_path.exists():
            button.set_tooltip_text("No audit results yet — run a scan first")
            return
        subprocess.Popen(["xdg-open", str(log_path)])
    
    def _delayed_refresh(self):
        """Refresh after a short delay."""
        self._on_refresh(None)
        return False
    
    def _on_refresh(self, button):
        # Rebuild the window
        for child in self.get_children():
            child.destroy()
        self.__init__()


def main():
    app = SecurityDashboard()
    app.connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
