[Desktop Entry]
Type=Application
Name=NubiferOS Security Dashboard
Comment=Show security status on first login after setup
Exec=/usr/local/bin/nubifer-dashboard-autostart
Icon=security-high
Terminal=false
Categories=System;Security;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Phase=Application
OnlyShowIn=GNOME;
NoDisplay=true
X-GNOME-Autostart-Delay=5
