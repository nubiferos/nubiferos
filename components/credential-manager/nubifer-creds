#!/usr/bin/env python3
"""
NubiferOS Credential Manager
Wrapper around pass (password-store) for secure credential management
Uses GPG encryption (battle-tested, audited) instead of custom encryption
"""

import os
import sys
import json
import argparse
import getpass
import subprocess
from pathlib import Path
from typing import Dict, List, Optional
from datetime import datetime

# Add src directory to path for imports
# Check installed location first, then development location
installed_path = '/usr/local/lib/nubifer/credential-manager/src'
dev_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'src')
if os.path.isdir(installed_path):
    sys.path.insert(0, installed_path)
else:
    sys.path.insert(0, dev_path)

class PassBackend:
    """Backend using pass (password-store) with GPG encryption"""
    
    def __init__(self, workspace: str = None):
        # Use active workspace from environment, or allow override
        self.workspace = workspace or os.getenv("NUBIFER_WORKSPACE_ID", "default")
        
        # Try to get workspace name from environment or workspace file
        if workspace:
            # Workspace was overridden, try to load name from file
            self.workspace_name = self._load_workspace_name(workspace)
        else:
            self.workspace_name = os.getenv("NUBIFER_WORKSPACE_NAME", self.workspace[:8] if len(self.workspace) > 8 else self.workspace)
        
        self.pass_dir = os.path.expanduser("~/.password-store")
        self.prefix = f"nubifer/{self.workspace}"
        self.audit_log = os.path.expanduser("~/.config/nubifer/audit.log")
        
        # Create audit log directory
        Path(os.path.dirname(self.audit_log)).mkdir(parents=True, exist_ok=True, mode=0o700)
        
        # Check if pass is initialized
        if not os.path.exists(self.pass_dir):
            print("⚠️  pass (password-store) not initialized")
            print("   Run: pass init <gpg-key-id>")
            print("   Or: gpg --full-generate-key  # to create GPG key first")
            sys.exit(1)
    
    def _load_workspace_name(self, workspace_id: str) -> str:
        """Load workspace name from JSON file"""
        workspace_file = Path.home() / ".config" / "nubifer" / "workspaces" / f"{workspace_id}.json"
        if workspace_file.exists():
            try:
                with open(workspace_file, 'r') as f:
                    data = json.load(f)
                    return data.get('name', workspace_id[:8])
            except:
                pass
        return workspace_id[:8] if len(workspace_id) > 8 else workspace_id
    
    def _run_pass(self, args: List[str], input_data: str = None) -> Optional[str]:
        """Run pass command"""
        try:
            if input_data:
                proc = subprocess.Popen(
                    ["pass"] + args,
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True
                )
                stdout, stderr = proc.communicate(input=input_data)
                if proc.returncode != 0:
                    print(f"Error: {stderr}", file=sys.stderr)
                    return None
                return stdout
            else:
                result = subprocess.run(
                    ["pass"] + args,
                    capture_output=True,
                    text=True,
                    check=True
                )
                return result.stdout.strip()
        except subprocess.CalledProcessError as e:
            return None
        except FileNotFoundError:
            print("Error: 'pass' command not found. Install with: apt-get install pass")
            sys.exit(1)
    
    def _audit_log_entry(self, action: str, path: str, details: str = ""):
        """Add entry to audit log"""
        timestamp = datetime.now().isoformat()
        user = os.getenv("USER", "unknown")
        
        log_entry = f"{timestamp} | {user} | {self.workspace} | {action} | {path} | {details}\n"
        
        with open(self.audit_log, 'a') as f:
            f.write(log_entry)
    
    def add_credential(self, path: str, value: str, multiline: bool = False):
        """Add credential using pass"""
        full_path = f"{self.prefix}/{path}"
        
        if multiline:
            self._run_pass(["insert", "-m", full_path], input_data=value)
        else:
            self._run_pass(["insert", "-e", full_path], input_data=f"{value}\n{value}\n")
        
        self._audit_log_entry("ADD", full_path)
    
    def get_credential(self, path: str) -> Optional[str]:
        """Get credential using pass"""
        full_path = f"{self.prefix}/{path}"
        
        value = self._run_pass(["show", full_path])
        
        if value:
            self._audit_log_entry("ACCESS", full_path)
        
        return value
    
    def list_credentials(self, subpath: str = "") -> List[str]:
        """List credentials using pass"""
        full_path = f"{self.prefix}/{subpath}" if subpath else self.prefix
        
        output = self._run_pass(["ls", full_path])
        if not output:
            return []
        
        # Parse pass ls output
        credentials = []
        for line in output.split('\n'):
            if '├──' in line or '└──' in line:
                # Extract credential name
                cred = line.split('──')[-1].strip()
                if cred and not cred.endswith('/'):
                    credentials.append(cred)
        
        return credentials
    
    def remove_credential(self, path: str):
        """Remove credential using pass"""
        full_path = f"{self.prefix}/{path}"
        
        self._run_pass(["rm", "-f", full_path])
        self._audit_log_entry("REMOVE", full_path)
    
    def generate_credential(self, path: str, length: int = 32):
        """Generate random credential using pass"""
        full_path = f"{self.prefix}/{path}"
        
        self._run_pass(["generate", "-n", full_path, str(length)])
        self._audit_log_entry("GENERATE", full_path)


class CredentialManager:
    """Main credential manager using pass backend"""
    
    def __init__(self, workspace: str = None):
        self.backend = PassBackend(workspace)
    
    def add_aws_credentials(self, profile: str, access_key_id: str, secret_access_key: str,
                             enable_sts: bool = True, sts_duration: int = 3600):
        """Add AWS credentials (region is set on workspace, not credential)"""
        # Store each component separately in pass
        self.backend.add_credential(f"cloud/aws/{profile}/access-key-id", access_key_id)
        self.backend.add_credential(f"cloud/aws/{profile}/secret-access-key", secret_access_key)

        print(f"✓ AWS credentials added: {profile}")
        print(f"  Workspace: {self.backend.workspace_name} ({self.backend.workspace})")

        # Enable STS token mode by default for security
        if enable_sts:
            try:
                # Import here to avoid issues if dependencies aren't installed
                sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), 'src'))
                from token_cache import TokenCache

                cache = TokenCache()
                if cache.enable_token_mode(self.backend.workspace, 'aws', profile, sts_duration):
                    print(f"✓ STS token mode enabled (default)")
                    print(f"  Token duration: {sts_duration} seconds ({sts_duration // 60} minutes)")
                    print(f"  Base credentials stay protected - only temp tokens are used")
                else:
                    print(f"  STS token mode: failed to enable (will use static credentials)")
            except ImportError:
                print(f"  STS token mode: not available (missing dependencies)")
                print(f"  Install with: pip install keyring cryptography boto3")
        else:
            print(f"  STS token mode: disabled (using static credentials)")

        print()
        print(f"  The AWS CLI will automatically use these credentials via credential_process.")
        print(f"  Region is set on the workspace, not the credential.")
        print(f"  Manage tokens: nubifer-creds token status -t aws -n {profile}")
    
    def get_aws_credentials(self, profile: str) -> Optional[Dict]:
        """Get AWS credentials (region comes from workspace, not here)"""
        access_key = self.backend.get_credential(f"cloud/aws/{profile}/access-key-id")
        secret_key = self.backend.get_credential(f"cloud/aws/{profile}/secret-access-key")
        
        if access_key and secret_key:
            return {
                "access_key_id": access_key,
                "secret_access_key": secret_key
            }
        return None
    
    def get_azure_credentials(self, name: str) -> Optional[Dict]:
        """Get Azure credentials"""
        tenant_id = self.backend.get_credential(f"cloud/azure/{name}/tenant-id")
        client_id = self.backend.get_credential(f"cloud/azure/{name}/client-id")
        client_secret = self.backend.get_credential(f"cloud/azure/{name}/client-secret")
        
        if tenant_id and client_id and client_secret:
            return {
                "tenant_id": tenant_id,
                "client_id": client_id,
                "client_secret": client_secret
            }
        return None
    
    def get_gcp_credentials(self, name: str) -> Optional[Dict]:
        """Get GCP credentials"""
        project_id = self.backend.get_credential(f"cloud/gcp/{name}/project-id")
        key_data = self.backend.get_credential(f"cloud/gcp/{name}/service-account-key")
        
        if project_id and key_data:
            return {
                "project_id": project_id,
                "service_account_key": key_data
            }
        return None
    
    def add_azure_credentials(self, name: str, tenant_id: str, client_id: str, client_secret: str):
        """Add Azure service principal credentials"""
        self.backend.add_credential(f"cloud/azure/{name}/tenant-id", tenant_id)
        self.backend.add_credential(f"cloud/azure/{name}/client-id", client_id)
        self.backend.add_credential(f"cloud/azure/{name}/client-secret", client_secret)
        
        print(f"✓ Azure credentials added: {name}")
        print(f"  Workspace: {self.backend.workspace_name} ({self.backend.workspace})")
        print(f"  Retrieve with: nubifer-creds get -t azure -n {name}")
    
    def add_gcp_credentials(self, name: str, project_id: str, key_file: str):
        """Add GCP service account credentials"""
        # Read key file
        with open(key_file, 'r') as f:
            key_data = f.read()
        
        # Store as multiline in pass
        self.backend.add_credential(f"cloud/gcp/{name}/service-account-key", key_data, multiline=True)
        self.backend.add_credential(f"cloud/gcp/{name}/project-id", project_id)
        
        print(f"✓ GCP credentials added: {name}")
        print(f"  Workspace: {self.backend.workspace_name} ({self.backend.workspace})")
        print(f"  Retrieve with: nubifer-creds get -t gcp -n {name}")
        
        # Securely delete original key file
        os.remove(key_file)
        print(f"  Original key file securely deleted")
    
    def add_api_token(self, service: str, token: str, scopes: str = ""):
        """Add API token"""
        self.backend.add_credential(f"api/{service}/token", token)
        if scopes:
            self.backend.add_credential(f"api/{service}/scopes", scopes)
        
        print(f"✓ API token added: {service}")
    
    def list_credentials(self, cred_type: str = None):
        """List all credentials"""
        subpath = f"cloud/{cred_type}" if cred_type else ""
        credentials = self.backend.list_credentials(subpath)
        
        if not credentials:
            print(f"No credentials found in workspace '{self.backend.workspace_name}'")
            print(f"  Add credentials: nubifer-creds add -t aws -n <profile-name>")
            return
        
        print(f"\nCredentials in workspace '{self.backend.workspace_name}' ({self.backend.workspace}):")
        print("-" * 60)
        
        for cred in credentials:
            print(f"  {cred}")
    
    def remove_credential(self, path: str):
        """Remove credential"""
        self.backend.remove_credential(path)
        print(f"✓ Credential removed: {path}")


def main():
    parser = argparse.ArgumentParser(description="NubiferOS Credential Manager")
    subparsers = parser.add_subparsers(dest="command", help="Commands")
    
    # Add command
    add_parser = subparsers.add_parser("add", help="Add credential")
    add_parser.add_argument("-t", "--type", required=True, choices=["aws", "azure", "gcp", "api", "db", "ssh"],
                           help="Credential type")
    add_parser.add_argument("-n", "--name", required=True, help="Credential name")
    add_parser.add_argument("-w", "--workspace", help="Target workspace ID (defaults to active workspace)")
    add_parser.add_argument("-y", "--yes", action="store_true", help="Skip confirmation prompt")
    
    # AWS specific
    add_parser.add_argument("--access-key-id", help="AWS access key ID")
    add_parser.add_argument("--secret-access-key", help="AWS secret access key")
    add_parser.add_argument("--no-sts", action="store_true",
                           help="Disable STS token mode (use static credentials instead)")
    add_parser.add_argument("--sts-duration", type=int, default=3600,
                           help="STS token duration in seconds (default: 3600)")
    
    # Azure specific
    add_parser.add_argument("--tenant-id", help="Azure tenant ID")
    add_parser.add_argument("--client-id", help="Azure client ID")
    add_parser.add_argument("--client-secret", help="Azure client secret")
    
    # GCP specific
    add_parser.add_argument("--project-id", help="GCP project ID")
    add_parser.add_argument("--key-file", help="GCP service account key file")
    
    # API specific
    add_parser.add_argument("--token", help="API token")
    add_parser.add_argument("--scopes", help="API scopes")
    
    # List command
    list_parser = subparsers.add_parser("list", help="List credentials")
    list_parser.add_argument("-t", "--type", choices=["aws", "azure", "gcp", "api", "db", "ssh"], 
                            help="Filter by type")
    
    # Get command
    get_parser = subparsers.add_parser("get", help="Get credential value")
    get_parser.add_argument("-t", "--type", required=True, choices=["aws", "azure", "gcp", "api"],
                           help="Credential type")
    get_parser.add_argument("-n", "--name", required=True, help="Credential name/profile")
    get_parser.add_argument("--json", action="store_true", help="Output as JSON")
    
    # Remove command
    remove_parser = subparsers.add_parser("remove", help="Remove credential")
    remove_parser.add_argument("path", help="Credential path (e.g., cloud/aws/profile-name)")

    # Token command (STS token management)
    token_parser = subparsers.add_parser("token", help="Manage STS temporary tokens")
    token_subparsers = token_parser.add_subparsers(dest="token_command", help="Token commands")

    # token enable
    token_enable = token_subparsers.add_parser("enable", help="Enable STS token mode for a credential")
    token_enable.add_argument("-t", "--type", required=True, choices=["aws"],
                              help="Credential type (only aws supported currently)")
    token_enable.add_argument("-n", "--name", required=True, help="Credential name/profile")
    token_enable.add_argument("-w", "--workspace", help="Workspace ID (defaults to active)")
    token_enable.add_argument("--duration", type=int, default=3600,
                              help="Token duration in seconds (900-43200, default: 3600)")

    # token disable
    token_disable = token_subparsers.add_parser("disable", help="Disable STS token mode")
    token_disable.add_argument("-t", "--type", required=True, choices=["aws"],
                               help="Credential type")
    token_disable.add_argument("-n", "--name", required=True, help="Credential name/profile")
    token_disable.add_argument("-w", "--workspace", help="Workspace ID (defaults to active)")

    # token status
    token_status = token_subparsers.add_parser("status", help="Show token status")
    token_status.add_argument("-t", "--type", required=True, choices=["aws"],
                              help="Credential type")
    token_status.add_argument("-n", "--name", required=True, help="Credential name/profile")
    token_status.add_argument("-w", "--workspace", help="Workspace ID (defaults to active)")
    token_status.add_argument("--json", action="store_true", help="Output as JSON")

    # token clear
    token_clear = token_subparsers.add_parser("clear", help="Clear cached token")
    token_clear.add_argument("-t", "--type", required=True, choices=["aws"],
                             help="Credential type")
    token_clear.add_argument("-n", "--name", required=True, help="Credential name/profile")
    token_clear.add_argument("-w", "--workspace", help="Workspace ID (defaults to active)")

    # token refresh
    token_refresh = token_subparsers.add_parser("refresh", help="Force refresh cached token")
    token_refresh.add_argument("-t", "--type", required=True, choices=["aws"],
                               help="Credential type")
    token_refresh.add_argument("-n", "--name", required=True, help="Credential name/profile")
    token_refresh.add_argument("-w", "--workspace", help="Workspace ID (defaults to active)")

    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return
    
    manager = CredentialManager()
    
    if args.command == "add":
        # Use specified workspace or active workspace
        workspace_override = getattr(args, 'workspace', None)
        if workspace_override:
            manager = CredentialManager(workspace=workspace_override)
        
        # Confirm workspace before adding credentials
        skip_confirm = getattr(args, 'yes', False)
        if not skip_confirm:
            print(f"\n⚠️  You are adding credentials to workspace:")
            print(f"   Name: {manager.backend.workspace_name}")
            print(f"   ID:   {manager.backend.workspace}")
            print()
            confirm = input("Continue? [y/N]: ").strip().lower()
            if confirm not in ('y', 'yes'):
                print("Cancelled.")
                sys.exit(0)
            print()
        
        if args.type == "aws":
            if not args.access_key_id:
                args.access_key_id = input("AWS Access Key ID: ")
            if not args.secret_access_key:
                args.secret_access_key = getpass.getpass("AWS Secret Access Key: ")

            enable_sts = not getattr(args, 'no_sts', False)
            sts_duration = getattr(args, 'sts_duration', 3600)

            manager.add_aws_credentials(args.name, args.access_key_id, args.secret_access_key,
                                       enable_sts=enable_sts, sts_duration=sts_duration)
        
        elif args.type == "azure":
            if not args.tenant_id:
                args.tenant_id = input("Azure Tenant ID: ")
            if not args.client_id:
                args.client_id = input("Azure Client ID: ")
            if not args.client_secret:
                args.client_secret = getpass.getpass("Azure Client Secret: ")
            
            manager.add_azure_credentials(args.name, args.tenant_id, args.client_id, args.client_secret)
        
        elif args.type == "gcp":
            if not args.project_id:
                args.project_id = input("GCP Project ID: ")
            if not args.key_file:
                args.key_file = input("GCP Service Account Key File: ")
            
            manager.add_gcp_credentials(args.name, args.project_id, args.key_file)
        
        elif args.type == "api":
            if not args.token:
                args.token = getpass.getpass(f"{args.name} API Token: ")
            
            manager.add_api_token(args.name, args.token, args.scopes or "")
    
    elif args.command == "list":
        manager.list_credentials(cred_type=args.type)
    
    elif args.command == "get":
        if args.type == "aws":
            creds = manager.get_aws_credentials(args.name)
            if creds:
                if args.json:
                    print(json.dumps(creds, indent=2))
                else:
                    print(f"AWS Credentials: {args.name}")
                    print(f"  Access Key ID: {creds['access_key_id']}")
                    print(f"  Secret Access Key: {creds['secret_access_key'][:4]}...{creds['secret_access_key'][-4:]}")
                    print(f"  (Region is set on workspace, not credential)")
            else:
                print(f"✗ Credentials not found: {args.name}", file=sys.stderr)
                sys.exit(1)
        elif args.type == "azure":
            creds = manager.get_azure_credentials(args.name)
            if creds:
                if args.json:
                    print(json.dumps(creds, indent=2))
                else:
                    print(f"Azure Credentials: {args.name}")
                    print(f"  Tenant ID: {creds['tenant_id']}")
                    print(f"  Client ID: {creds['client_id']}")
                    print(f"  Client Secret: {creds['client_secret'][:4]}...{creds['client_secret'][-4:]}")
            else:
                print(f"✗ Credentials not found: {args.name}", file=sys.stderr)
                sys.exit(1)
        elif args.type == "gcp":
            creds = manager.get_gcp_credentials(args.name)
            if creds:
                if args.json:
                    print(json.dumps(creds, indent=2))
                else:
                    print(f"GCP Credentials: {args.name}")
                    print(f"  Project ID: {creds['project_id']}")
                    print(f"  Service Account Key: [stored]")
            else:
                print(f"✗ Credentials not found: {args.name}", file=sys.stderr)
                sys.exit(1)
    
    elif args.command == "remove":
        manager.remove_credential(args.path)

    elif args.command == "token":
        handle_token_command(args)


def handle_token_command(args):
    """Handle token subcommands"""
    if not args.token_command:
        print("Usage: nubifer-creds token {enable|disable|status|clear|refresh} ...")
        print("Run 'nubifer-creds token -h' for help")
        sys.exit(1)

    # Get workspace
    workspace = getattr(args, 'workspace', None) or os.getenv("NUBIFER_WORKSPACE_ID", "default")
    cred_type = args.type
    cred_name = args.name

    try:
        from token_cache import TokenCache
        cache = TokenCache()
    except ImportError as e:
        print(f"Error: Token cache module not available: {e}", file=sys.stderr)
        print("Install required dependencies: pip install keyring cryptography boto3")
        sys.exit(1)

    if args.token_command == "enable":
        duration = getattr(args, 'duration', 3600)

        # Validate duration
        if duration < 900:
            print("Warning: Minimum duration is 900 seconds (15 minutes), using 900")
            duration = 900
        elif duration > 43200:
            print("Warning: Maximum duration is 43200 seconds (12 hours), using 43200")
            duration = 43200

        # Check if base credentials exist
        base_path = f"nubifer/{workspace}/cloud/{cred_type}/{cred_name}"
        try:
            result = subprocess.run(
                ["pass", "show", f"{base_path}/access-key-id"],
                capture_output=True,
                text=True,
                timeout=10
            )
            if result.returncode != 0:
                print(f"Error: Base credentials not found for '{cred_name}' in workspace '{workspace}'")
                print(f"Add credentials first: nubifer-creds add -t {cred_type} -n {cred_name}")
                sys.exit(1)
        except Exception as e:
            print(f"Error checking credentials: {e}", file=sys.stderr)
            sys.exit(1)

        if cache.enable_token_mode(workspace, cred_type, cred_name, duration):
            print(f"Token mode enabled: {cred_type}/{cred_name}")
            print(f"  Workspace: {workspace}")
            print(f"  Duration: {duration} seconds ({duration // 60} minutes)")
            print()
            print("STS tokens will be automatically generated and cached.")
            print("Tokens refresh automatically when expired or within 5 minutes of expiry.")
        else:
            print("Failed to enable token mode", file=sys.stderr)
            sys.exit(1)

    elif args.token_command == "disable":
        if cache.disable_token_mode(workspace, cred_type, cred_name):
            print(f"Token mode disabled: {cred_type}/{cred_name}")
            print("Static credentials will be used for future requests.")
        else:
            print("Failed to disable token mode", file=sys.stderr)
            sys.exit(1)

    elif args.token_command == "status":
        settings = cache.get_token_settings(workspace, cred_type, cred_name)

        if getattr(args, 'json', False):
            if settings:
                print(json.dumps(settings, indent=2))
            else:
                print(json.dumps({"enabled": False}))
            return

        print(f"Token Status: {cred_type}/{cred_name}")
        print(f"  Workspace: {workspace}")
        print("-" * 40)

        if not settings:
            print("  Token mode: disabled (never configured)")
            return

        print(f"  Token mode: {'enabled' if settings['enabled'] else 'disabled'}")
        print(f"  Duration: {settings['duration_seconds']} seconds")

        if settings.get('token_expires_at'):
            remaining = settings.get('token_remaining_seconds', 0)
            if remaining > 0:
                mins = remaining // 60
                secs = remaining % 60
                print(f"  Cached token: valid ({mins}m {secs}s remaining)")
                print(f"  Expires: {settings['token_expires_at']}")
                print(f"  Storage: {settings.get('storage_type', 'unknown')}")
            else:
                print("  Cached token: expired")
        else:
            print("  Cached token: none")

    elif args.token_command == "clear":
        if cache.clear_token(workspace, cred_type, cred_name):
            print(f"Token cache cleared: {cred_type}/{cred_name}")
            print("A new token will be generated on next use.")
        else:
            print("Failed to clear token cache", file=sys.stderr)
            sys.exit(1)

    elif args.token_command == "refresh":
        # Clear existing cache and force regeneration
        cache.clear_token(workspace, cred_type, cred_name)

        if not cache.is_token_enabled(workspace, cred_type, cred_name):
            print(f"Error: Token mode not enabled for {cred_type}/{cred_name}")
            print(f"Enable first: nubifer-creds token enable -t {cred_type} -n {cred_name}")
            sys.exit(1)

        try:
            from token_generators.aws import AWSTokenGenerator, AWSTokenGeneratorError
            generator = AWSTokenGenerator(workspace)
            duration = cache.get_duration_seconds(workspace, cred_type, cred_name)

            print(f"Generating new STS token for {cred_type}/{cred_name}...")
            token_data, expiration = generator.get_session_token(cred_name, duration_seconds=duration)

            if token_data and expiration:
                cache.store_token(workspace, cred_type, cred_name, token_data, expiration)
                print(f"Token refreshed successfully")
                print(f"  Expires: {expiration.isoformat()}")
            else:
                print("Failed to generate token", file=sys.stderr)
                sys.exit(1)

        except AWSTokenGeneratorError as e:
            print(f"Token generation failed: {e}", file=sys.stderr)
            sys.exit(1)
        except ImportError as e:
            print(f"Error: boto3 not installed: {e}", file=sys.stderr)
            print("Install with: pip install boto3")
            sys.exit(1)


if __name__ == "__main__":
    main()
