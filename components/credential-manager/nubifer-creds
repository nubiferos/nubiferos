class PassBackend:
    """Backend using pass (password-store) with GPG encryption"""
    
    def __init__(self, workspace: str = None):
        # Use active workspace from environment, or allow override
        self.workspace = workspace or os.getenv("NUBIFER_WORKSPACE_ID", "default")
        
        # Try to get workspace name from environment or workspace file
        if workspace:
            # Workspace was overridden, try to load name from file
            self.workspace_name = self._load_workspace_name(workspace)
        else:
            self.workspace_name = os.getenv("NUBIFER_WORKSPACE_NAME", self.workspace[:8] if len(self.workspace) > 8 else self.workspace)
        
        self.pass_dir = os.path.expanduser("~/.password-store")
        self.prefix = f"nubifer/{self.workspace}"
        self.audit_log = os.path.expanduser("~/.config/nubifer/audit.log")
        
        # Create audit log directory
        Path(os.path.dirname(self.audit_log)).mkdir(parents=True, exist_ok=True, mode=0o700)
        
        # Check if pass is initialized
        if not os.path.exists(self.pass_dir):
            print("⚠️  pass (password-store) not initialized")
            print("   Run: pass init <gpg-key-id>")
            print("   Or: gpg --full-generate-key  # to create GPG key first")
            sys.exit(1)
    
    def _load_workspace_name(self, workspace_id: str) -> str:
        """Load workspace name from JSON file"""
        workspace_file = Path.home() / ".config" / "nubifer" / "workspaces" / f"{workspace_id}.json"
        if workspace_file.exists():
            try:
                with open(workspace_file, 'r') as f:
                    data = json.load(f)
                    return data.get('name', workspace_id[:8])
            except:
                pass
        return workspace_id[:8] if len(workspace_id) > 8 else workspace_id
    
    def _run_pass(self, args: List[str], input_data: str = None) -> Optional[str]:
        """Run pass command"""
        try:
            if input_data:
                proc = subprocess.Popen(
                    ["pass"] + args,
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True
                )
                stdout, stderr = proc.communicate(input=input_data)
                if proc.returncode != 0:
                    print(f"Error: {stderr}", file=sys.stderr)
                    return None
                return stdout
            else:
                result = subprocess.run(
                    ["pass"] + args,
                    capture_output=True,
                    text=True,
                    check=True
                )
                return result.stdout.strip()
        except subprocess.CalledProcessError as e:
            return None
        except FileNotFoundError:
            print("Error: 'pass' command not found. Install with: apt-get install pass")
            sys.exit(1)
    
    def _audit_log_entry(self, action: str, path: str, details: str = ""):
        """Add entry to audit log"""
        timestamp = datetime.now().isoformat()
        user = os.getenv("USER", "unknown")
        
        log_entry = f"{timestamp} | {user} | {self.workspace} | {action} | {path} | {details}\n"
        
        with open(self.audit_log, 'a') as f:
            f.write(log_entry)
    
    def add_credential(self, path: str, value: str, multiline: bool = False):
        """Add credential using pass"""
        full_path = f"{self.prefix}/{path}"
        
        if multiline:
            self._run_pass(["insert", "-m", full_path], input_data=value)
        else:
            self._run_pass(["insert", "-e", full_path], input_data=f"{value}\n{value}\n")
        
        self._audit_log_entry("ADD", full_path)
    
    def get_credential(self, path: str) -> Optional[str]:
        """Get credential using pass"""
        full_path = f"{self.prefix}/{path}"
        
        value = self._run_pass(["show", full_path])
        
        if value:
            self._audit_log_entry("ACCESS", full_path)
        
        return value
    
    def list_credentials(self, subpath: str = "") -> List[str]:
        """List credentials using pass"""
        full_path = f"{self.prefix}/{subpath}" if subpath else self.prefix
        
        output = self._run_pass(["ls", full_path])
        if not output:
            return []
        
        # Parse pass ls output
        credentials = []
        for line in output.split('\n'):
            if '├──' in line or '└──' in line:
                # Extract credential name
                cred = line.split('──')[-1].strip()
                if cred and not cred.endswith('/'):
                    credentials.append(cred)
        
        return credentials
    
    def remove_credential(self, path: str):
        """Remove credential using pass"""
        full_path = f"{self.prefix}/{path}"
        
        self._run_pass(["rm", "-f", full_path])
        self._audit_log_entry("REMOVE", full_path)
    
    def generate_credential(self, path: str, length: int = 32):
        """Generate random credential using pass"""
        full_path = f"{self.prefix}/{path}"
        
        self._run_pass(["generate", "-n", full_path, str(length)])
        self._audit_log_entry("GENERATE", full_path)


class CredentialManager:
    """Main credential manager using pass backend"""
    
    def __init__(self, workspace: str = None):
        self.backend = PassBackend(workspace)
    
    def add_aws_credentials(self, profile: str, access_key_id: str, secret_access_key: str,
                             enable_sts: bool = True, sts_duration: int = 3600):
        """Add AWS credentials (region is set on workspace, not credential)"""
        # Store each component separately in pass
        self.backend.add_credential(f"cloud/aws/{profile}/access-key-id", access_key_id)
        self.backend.add_credential(f"cloud/aws/{profile}/secret-access-key", secret_access_key)

        print(f"✓ AWS credentials added: {profile}")
        print(f"  Workspace: {self.backend.workspace_name} ({self.backend.workspace})")

        # Enable STS token mode by default for security
        if enable_sts:
            try:
                # Import here to avoid issues if dependencies aren't installed
                sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), 'src'))
                from token_cache import TokenCache

                cache = TokenCache()
                if cache.enable_token_mode(self.backend.workspace, 'aws', profile, sts_duration):
                    print(f"✓ STS token mode enabled (default)")
                    print(f"  Token duration: {sts_duration} seconds ({sts_duration // 60} minutes)")
                    print(f"  Base credentials stay protected - only temp tokens are used")
                else:
                    print(f"  STS token mode: failed to enable (will use static credentials)")
            except ImportError:
                print(f"  STS token mode: not available (missing dependencies)")
                print(f"  Install with: pip install keyring cryptography boto3")
        else:
            print(f"  STS token mode: disabled (using static credentials)")

        print()
        print(f"  The AWS CLI will automatically use these credentials via credential_process.")
        print(f"  Region is set on the workspace, not the credential.")
        print(f"  Manage tokens: nubifer-creds token status -t aws -n {profile}")
    
    def get_aws_credentials(self, profile: str) -> Optional[Dict]:
        """Get AWS credentials (region comes from workspace, not here)"""
        access_key = self.backend.get_credential(f"cloud/aws/{profile}/access-key-id")
        secret_key = self.backend.get_credential(f"cloud/aws/{profile}/secret-access-key")
        
        if access_key and secret_key:
            return {
                "access_key_id": access_key,
                "secret_access_key": secret_key
            }
        return None
    
    def get_azure_credentials(self, name: str) -> Optional[Dict]:
        """Get Azure credentials"""
        tenant_id = self.backend.get_credential(f"cloud/azure/{name}/tenant-id")
        client_id = self.backend.get_credential(f"cloud/azure/{name}/client-id")
        client_secret = self.backend.get_credential(f"cloud/azure/{name}/client-secret")
        
        if tenant_id and client_id and client_secret:
            return {
                "tenant_id": tenant_id,
                "client_id": client_id,
                "client_secret": client_secret
            }
        return None
    
    def get_gcp_credentials(self, name: str) -> Optional[Dict]:
        """Get GCP credentials"""
        project_id = self.backend.get_credential(f"cloud/gcp/{name}/project-id")
        key_data = self.backend.get_credential(f"cloud/gcp/{name}/service-account-key")
        
        if project_id and key_data:
            return {
                "project_id": project_id,
                "service_account_key": key_data
            }
        return None
    
    def add_azure_credentials(self, name: str, tenant_id: str, client_id: str, client_secret: str):
        """Add Azure service principal credentials"""
        self.backend.add_credential(f"cloud/azure/{name}/tenant-id", tenant_id)
        self.backend.add_credential(f"cloud/azure/{name}/client-id", client_id)
        self.backend.add_credential(f"cloud/azure/{name}/client-secret", client_secret)
        
        print(f"✓ Azure credentials added: {name}")
        print(f"  Workspace: {self.backend.workspace_name} ({self.backend.workspace})")
        print(f"  Retrieve with: nubifer-creds get -t azure -n {name}")
    
    def add_gcp_credentials(self, name: str, project_id: str, key_file: str):
        """Add GCP service account credentials"""
        # Read key file
        with open(key_file, 'r') as f:
            key_data = f.read()
        
        # Store as multiline in pass
        self.backend.add_credential(f"cloud/gcp/{name}/service-account-key", key_data, multiline=True)
        self.backend.add_credential(f"cloud/gcp/{name}/project-id", project_id)
        
        print(f"✓ GCP credentials added: {name}")
        print(f"  Workspace: {self.backend.workspace_name} ({self.backend.workspace})")
        print(f"  Retrieve with: nubifer-creds get -t gcp -n {name}")
        
        # Securely delete original key file
        os.remove(key_file)
        print(f"  Original key file securely deleted")
    
    def get_api_token(self, service: str) -> Optional[Dict]:
        """Get API token"""
        token = self.backend.get_credential(f"api/{service}/token")
        if token:
            result = {"token": token}
            scopes = self.backend.get_credential(f"api/{service}/scopes")
            if scopes:
                result["scopes"] = scopes
            return result
        return None

    def add_api_token(self, service: str, token: str, scopes: str = ""):
        """Add API token"""
        self.backend.add_credential(f"api/{service}/token", token)
        if scopes:
            self.backend.add_credential(f"api/{service}/scopes", scopes)
        
        print(f"✓ API token added: {service}")
    
    def list_credentials(self, cred_type: str = None):
        """List all credentials"""
        subpath = f"cloud/{cred_type}" if cred_type else ""
        credentials = self.backend.list_credentials(subpath)
        
        if not credentials:
            print(f"No credentials found in workspace '{self.backend.workspace_name}'")
            print(f"  Add credentials: nubifer-creds add -t aws -n <profile-name>")
            return
        
        print(f"\nCredentials in workspace '{self.backend.workspace_name}' ({self.backend.workspace}):")
        print("-" * 60)
        
        for cred in credentials:
            print(f"  {cred}")
    
    def remove_credential(self, path: str):
        """Remove credential"""
        self.backend.remove_credential(path)
        print(f"✓ Credential removed: {path}")


# ---------------------------------------------------------------------------
# Modern cloud auth: guided SSO login + session visibility
# (modern-cloud-auth Requirements 2, 3, 4.1, 5.1)
#
# Provider CLIs (aws sso login / az login / gcloud auth login) own their
# token lifecycles. NubiferOS only scopes their config/cache dirs to the
# active workspace (Session Broker, workspace-manager) and orchestrates the
# login. SSO *configuration* (non-secret) lives in the workspace config;
# SSO tokens are NEVER stored in the pass vault.
# ---------------------------------------------------------------------------

SESSION_PROVIDERS = ("aws", "azure", "gcp")

# Must match AWS_SSO_SESSION_NAME in the workspace manager (Session Broker)
AWS_SSO_SESSION_NAME = "nubifer"

_workspace_manager_module = None
_workspace_manager_load_attempted = False


def _load_workspace_manager():
    """Load the workspace-manager module (Session Broker API).

    Tries the development checkout first (sibling component), then the
    installed location. Returns None if unavailable - callers degrade
    gracefully (scoped paths are constructed from the known layout).
    """
    global _workspace_manager_module, _workspace_manager_load_attempted
    if _workspace_manager_load_attempted:
        return _workspace_manager_module
    _workspace_manager_load_attempted = True

    import importlib.util
    from importlib.machinery import SourceFileLoader

    candidates = [
        os.path.join(os.path.dirname(os.path.abspath(__file__)),
                     '..', 'workspace-manager', 'nubifer-workspace'),
        '/usr/local/bin/nubifer-workspace',
    ]
    for candidate in candidates:
        candidate = os.path.abspath(candidate)
        if not os.path.isfile(candidate):
            continue
        try:
            loader = SourceFileLoader('nubifer_workspace', candidate)
            spec = importlib.util.spec_from_loader('nubifer_workspace', loader)
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
            _workspace_manager_module = module
            break
        except Exception:
            continue
    return _workspace_manager_module


def _parse_session_timestamp(value: Optional[str]) -> Optional[datetime]:
    """Parse a provider expiry timestamp (ISO 8601, 'Z'/'UTC' suffixes)"""
    if not value:
        return None
    ts = value.strip()
    if ts.endswith('Z'):
        ts = ts[:-1] + '+00:00'
    elif ts.endswith('UTC'):
        ts = ts[:-3] + '+00:00'
    try:
        parsed = datetime.fromisoformat(ts)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed


def _humanize_remaining(seconds: float) -> str:
    """'2h 05m' style remaining-time display"""
    seconds = int(seconds)
    hours, rem = divmod(seconds, 3600)
    minutes = rem // 60
    if hours > 0:
        return f"{hours}h {minutes:02d}m"
    return f"{minutes}m"


class SessionManager:
    """Guided SSO login and session visibility for the active workspace.

    Does not require the pass vault: SSO tokens are cached by the provider
    CLIs inside the workspace-scoped dirs (Session Broker). Only non-secret
    session metadata (provider, identity, expiry) is recorded in the
    workspace config for the context indicator and `status`.
    """

    def __init__(self, workspace_id: str = None):
        self.config_dir = Path.home() / '.config' / 'nubifer'
        self.workspace_dir = self.config_dir / 'workspaces'
        self.audit_log = self.config_dir / 'audit.log'
        Path(self.config_dir).mkdir(parents=True, exist_ok=True, mode=0o700)

        self.workspace_id = workspace_id or self._active_workspace_id()
        if not self.workspace_id:
            print("✗ No active workspace", file=sys.stderr)
            print("  Switch first: nubifer-workspace switch <workspace-id>",
                  file=sys.stderr)
            print("  Or target one explicitly with -w <workspace-id>",
                  file=sys.stderr)
            sys.exit(1)

        if not self._workspace_file().exists():
            print(f"✗ Workspace not found: {self.workspace_id}", file=sys.stderr)
            sys.exit(1)

    # -- workspace config plumbing ---------------------------------------

    def _active_workspace_id(self) -> Optional[str]:
        workspace_id = os.getenv("NUBIFER_WORKSPACE_ID")
        if workspace_id:
            return workspace_id
        current_file = self.config_dir / 'current-workspace'
        if current_file.exists():
            try:
                return current_file.read_text().strip() or None
            except OSError:
                return None
        return None

    def _workspace_file(self) -> Path:
        return self.workspace_dir / f"{self.workspace_id}.json"

    def _load_workspace(self) -> Dict:
        with open(self._workspace_file(), 'r') as f:
            return json.load(f)

    def _save_workspace(self, workspace: Dict):
        workspace_file = self._workspace_file()
        with open(workspace_file, 'w') as f:
            json.dump(workspace, f, indent=2)
        workspace_file.chmod(0o600)

    def _audit(self, action: str, provider: str, details: str = ""):
        """Audit entry - same format/discipline as PassBackend (no secrets)"""
        timestamp = datetime.now().isoformat()
        user = os.getenv("USER", "unknown")
        log_entry = (f"{timestamp} | {user} | {self.workspace_id} | {action}"
                     f" | session/{provider} | {details}\n")
        with open(self.audit_log, 'a') as f:
            f.write(log_entry)

    # -- Session Broker integration --------------------------------------

    def _providers_dir(self) -> Path:
        return self.workspace_dir / self.workspace_id / 'providers'

    def _scoped_env(self) -> Dict[str, str]:
        """Environment with provider config/cache scoped to the workspace"""
        env = dict(os.environ)
        wm = _load_workspace_manager()
        if wm is not None:
            env.update(wm.WorkspaceManager().provider_env(self.workspace_id))
        else:
            providers = self._providers_dir()
            env.update({
                'AWS_CONFIG_FILE': str(providers / 'aws' / 'config'),
                'AWS_SHARED_CREDENTIALS_FILE': str(providers / 'aws' / 'credentials'),
                'CLOUDSDK_CONFIG': str(providers / 'gcloud'),
                'AZURE_CONFIG_DIR': str(providers / 'azure'),
            })
        env['NUBIFER_WORKSPACE'] = self.workspace_id
        env['NUBIFER_WORKSPACE_ID'] = self.workspace_id
        return env

    def _refresh_provider_configs(self, workspace: Dict):
        """Ask the Session Broker to (re)provision generated configs"""
        wm = _load_workspace_manager()
        if wm is None:
            print("⚠️  workspace manager not found - scoped provider configs "
                  "not refreshed", file=sys.stderr)
            return
        try:
            wm.WorkspaceManager().refresh_provider_configs(
                self.workspace_id, workspace)
        except Exception as e:
            print(f"⚠️  Could not refresh scoped provider configs: {e}",
                  file=sys.stderr)

    # -- SSO configuration storage (Req 2.2, 2.5, 3.1-3.3) ---------------

    def setup(self, provider: str, options: Dict[str, Optional[str]]):
        """Store non-secret SSO configuration / role bindings.

        Values land in the workspace config file - NEVER in the pass vault.
        """
        workspace = self._load_workspace()
        stored = []

        if provider == 'aws':
            sso = workspace.setdefault('sso', {}).setdefault('aws', {})
            for key in ('sso_start_url', 'sso_region',
                        'sso_account_id', 'sso_role_name'):
                if options.get(key):
                    sso[key] = options[key]
                    stored.append(key)
            if options.get('role_arn'):
                workspace['aws_role_arn'] = options['role_arn']
                stored.append('aws_role_arn')
        elif provider == 'azure':
            if options.get('tenant'):
                workspace['azure_tenant'] = options['tenant']
                stored.append('azure_tenant')
            if options.get('subscription'):
                workspace['azure_subscription'] = options['subscription']
                stored.append('azure_subscription')
        elif provider == 'gcp':
            if options.get('project'):
                workspace.setdefault('sso', {}).setdefault('gcp', {})['project'] = \
                    options['project']
                stored.append('project')
            if options.get('impersonate_service_account'):
                workspace['gcp_impersonate_service_account'] = \
                    options['impersonate_service_account']
                stored.append('gcp_impersonate_service_account')

        if not stored:
            print(f"✗ Nothing to store for provider '{provider}'", file=sys.stderr)
            hints = {
                'aws': "--sso-start-url, --sso-region, --sso-account-id, "
                       "--sso-role-name, --role-arn",
                'azure': "--tenant, --subscription",
                'gcp': "--project, --impersonate-service-account",
            }
            print(f"  Options for {provider}: {hints[provider]}", file=sys.stderr)
            sys.exit(1)

        self._save_workspace(workspace)
        self._refresh_provider_configs(workspace)
        self._audit("SSO_SETUP", provider, f"keys={','.join(stored)}")

        print(f"✓ SSO configuration stored: {provider}")
        print(f"  Workspace: {workspace.get('name', '?')} ({self.workspace_id})")
        print(f"  Updated: {', '.join(stored)}")
        print(f"  Config is non-secret and lives in the workspace config;")
        print(f"  tokens stay in the provider CLI's workspace-scoped cache.")
        print(f"  Log in with: nubifer-creds login -t {provider}")

    # -- guided login (Req 2.1-2.3) --------------------------------------

    def login(self, provider: str) -> bool:
        workspace = self._load_workspace()
        env = self._scoped_env()
        self._refresh_provider_configs(workspace)

        if provider == 'aws':
            ok, identity, expires_at = self._login_aws(workspace, env)
        elif provider == 'azure':
            ok, identity, expires_at = self._login_azure(workspace, env)
        elif provider == 'gcp':
            ok, identity, expires_at = self._login_gcp(workspace, env)
        else:
            print(f"✗ Unsupported provider: {provider}", file=sys.stderr)
            return False

        if not ok:
            self._audit("LOGIN_FAILED", provider)
            print(f"✗ Login failed: {provider}", file=sys.stderr)
            return False

        self._record_session(provider, identity, expires_at)
        self._audit("LOGIN", provider,
                    f"identity={identity or 'unknown'}, "
                    f"expires={expires_at or 'unknown'}")

        print(f"✓ Logged in: {provider}")
        print(f"  Workspace: {workspace.get('name', '?')} ({self.workspace_id})")
        if identity:
            print(f"  Identity: {identity}")
        if expires_at:
            print(f"  Session expires: {expires_at}")
        print(f"  Session state: nubifer-creds status")
        return True

    def _login_aws(self, workspace, env):
        sso = (workspace.get('sso') or {}).get('aws') or {}
        if not sso.get('sso_start_url'):
            print("✗ No AWS SSO configuration stored for this workspace",
                  file=sys.stderr)
            print("  Store it once (non-secret, non-interactive logins after):",
                  file=sys.stderr)
            print("    nubifer-creds login setup -t aws \\", file=sys.stderr)
            print("      --sso-start-url https://my-org.awsapps.com/start \\",
                  file=sys.stderr)
            print("      --sso-region us-east-1 "
                  "--sso-account-id 123456789012 --sso-role-name MyRole",
                  file=sys.stderr)
            return False, None, None

        result = subprocess.run(
            ["aws", "sso", "login", "--sso-session", AWS_SSO_SESSION_NAME],
            env=env)
        if result.returncode != 0:
            return False, None, None

        identity = self._aws_identity(env)
        expires_at = self._aws_sso_expiry()
        return True, identity, expires_at

    def _login_azure(self, workspace, env):
        cmd = ["az", "login", "--use-device-code"]
        if workspace.get('azure_tenant'):
            cmd += ["--tenant", workspace['azure_tenant']]
        result = subprocess.run(cmd, env=env)
        if result.returncode != 0:
            return False, None, None

        # Subscription binding applied at login (Req 3.3)
        if workspace.get('azure_subscription'):
            subprocess.run(
                ["az", "account", "set",
                 "--subscription", workspace['azure_subscription']],
                env=env)

        identity = None
        try:
            result = subprocess.run(
                ["az", "account", "show", "--output", "json"],
                env=env, capture_output=True, text=True, timeout=30)
            if result.returncode == 0:
                identity = (json.loads(result.stdout)
                            .get('user', {}).get('name'))
        except Exception:
            pass  # Identity display degrades gracefully
        return True, identity, None  # az refreshes tokens itself; no cheap expiry

    def _login_gcp(self, workspace, env):
        result = subprocess.run(["gcloud", "auth", "login"], env=env)
        if result.returncode != 0:
            return False, None, None

        # Impersonation / project bindings (Req 3.2) - applied to the
        # workspace-scoped gcloud config (CLOUDSDK_CONFIG)
        if workspace.get('gcp_impersonate_service_account'):
            subprocess.run(
                ["gcloud", "config", "set", "auth/impersonate_service_account",
                 workspace['gcp_impersonate_service_account']],
                env=env)
        project = ((workspace.get('sso') or {}).get('gcp') or {}).get('project')
        if not project and workspace.get('provider') == 'gcp':
            project = workspace.get('account_id')
        if project:
            subprocess.run(["gcloud", "config", "set", "project", project],
                           env=env)

        identity = None
        try:
            result = subprocess.run(
                ["gcloud", "config", "get-value", "account"],
                env=env, capture_output=True, text=True, timeout=30)
            if result.returncode == 0:
                value = result.stdout.strip()
                if value and value != '(unset)':
                    identity = value
        except Exception:
            pass
        return True, identity, None  # gcloud refresh tokens have no fixed expiry

    def _aws_identity(self, env) -> Optional[str]:
        try:
            result = subprocess.run(
                ["aws", "sts", "get-caller-identity", "--output", "json"],
                env=env, capture_output=True, text=True, timeout=30)
            if result.returncode == 0:
                return json.loads(result.stdout).get('Arn')
        except Exception:
            pass
        return None

    def _aws_sso_expiry(self) -> Optional[str]:
        """Latest expiresAt from the workspace-scoped AWS SSO token cache"""
        cache_dir = self._providers_dir() / 'aws' / 'sso' / 'cache'
        latest_str, latest = None, None
        if not cache_dir.is_dir():
            return None
        for cache_file in cache_dir.glob('*.json'):
            try:
                with open(cache_file, 'r') as f:
                    expires_at = json.load(f).get('expiresAt')
            except (OSError, ValueError):
                continue
            parsed = _parse_session_timestamp(expires_at)
            if parsed and (latest is None or parsed > latest):
                latest, latest_str = parsed, expires_at
        return latest_str

    def _record_session(self, provider: str, identity: Optional[str],
                        expires_at: Optional[str]):
        """Non-secret session metadata for status / context indicator"""
        workspace = self._load_workspace()
        sessions = workspace.setdefault('sessions', {})
        sessions[provider] = {
            'mode': 'sso',
            'identity': identity,
            'expires_at': expires_at,
            'logged_in_at': datetime.now(timezone.utc).isoformat(),
        }
        self._save_workspace(workspace)

    # -- logout (Req 5.3) ------------------------------------------------

    def logout(self, provider: str = None) -> bool:
        workspace = self._load_workspace()
        sessions = workspace.get('sessions') or {}
        providers = [provider] if provider else [
            p for p in SESSION_PROVIDERS if p in sessions]
        if not providers:
            print("No recorded provider sessions to log out")
            return True

        env = self._scoped_env()
        logout_cmds = {
            'aws': ["aws", "sso", "logout"],
            'azure': ["az", "logout"],
            'gcp': ["gcloud", "auth", "revoke", "--all"],
        }
        for p in providers:
            try:
                subprocess.run(logout_cmds[p], env=env,
                               capture_output=True, timeout=60)
            except Exception:
                pass  # Session metadata is cleared regardless
            if p in sessions:
                sessions.pop(p, None)
            self._audit("LOGOUT", p)
            print(f"✓ Logged out: {p}")

        workspace['sessions'] = sessions
        self._save_workspace(workspace)
        return True

    # -- status (Req 5.1, 4.1) -------------------------------------------

    def _static_profiles(self, provider: str) -> List[str]:
        """Static credentials in the pass vault for this workspace/provider.

        File-existence check only (like the aws wrapper) - never triggers
        GPG decryption or pinentry.
        """
        pass_dir = Path(os.environ.get(
            'PASSWORD_STORE_DIR', str(Path.home() / '.password-store')))
        provider_dir = pass_dir / 'nubifer' / self.workspace_id / 'cloud' / provider
        if not provider_dir.is_dir():
            return []
        return sorted(p.name for p in provider_dir.iterdir() if p.is_dir())

    def _sso_configured(self, workspace: Dict, provider: str) -> bool:
        sso = workspace.get('sso') or {}
        if provider == 'aws':
            return bool(sso.get('aws'))
        if provider == 'azure':
            return bool(sso.get('azure') or workspace.get('azure_tenant')
                        or workspace.get('azure_subscription'))
        if provider == 'gcp':
            return bool(sso.get('gcp')
                        or workspace.get('gcp_impersonate_service_account'))
        return False

    def _provider_status(self, workspace: Dict, provider: str) -> Dict:
        """Auth mode (sso/static/none), identity and expiry for one provider.

        Resolution order (Req 4.2): an SSO session/configuration takes
        precedence over static vault credentials; static shows as fallback.
        """
        session = (workspace.get('sessions') or {}).get(provider) or {}
        static_profiles = self._static_profiles(provider)
        info = {
            'mode': 'none',
            'identity': None,
            'expires_at': None,
            'state': None,
            'static_fallback': False,
        }

        if session:
            info['mode'] = session.get('mode', 'sso')
            info['identity'] = session.get('identity')
            info['expires_at'] = session.get('expires_at')
            info['static_fallback'] = bool(static_profiles)
            expires = _parse_session_timestamp(info['expires_at'])
            if expires is None:
                info['state'] = 'active'
            elif expires <= datetime.now(timezone.utc):
                info['state'] = 'expired'
                if not session.get('expiry_logged'):
                    session['expiry_logged'] = True
                    self._audit("SESSION_EXPIRED", provider,
                                f"expired={info['expires_at']}")
                    self._expiry_flag_changed = True
            else:
                info['state'] = 'active'
                remaining = (expires - datetime.now(timezone.utc)).total_seconds()
                info['remaining'] = _humanize_remaining(remaining)
        elif self._sso_configured(workspace, provider):
            info['mode'] = 'sso'
            info['state'] = 'not logged in'
            info['static_fallback'] = bool(static_profiles)
        elif static_profiles:
            info['mode'] = 'static'
            info['identity'] = ', '.join(static_profiles)

        return info

    def status(self, json_output: bool = False):
        workspace = self._load_workspace()
        self._expiry_flag_changed = False

        rows = {}
        for provider in SESSION_PROVIDERS:
            rows[provider] = self._provider_status(workspace, provider)

        # Persist one-shot expiry flags so SESSION_EXPIRED is logged once
        if self._expiry_flag_changed:
            self._save_workspace(workspace)

        if json_output:
            print(json.dumps({
                'workspace_id': self.workspace_id,
                'workspace_name': workspace.get('name'),
                'providers': rows,
            }, indent=2))
            return

        print(f"\nSession status - workspace "
              f"'{workspace.get('name', '?')}' ({self.workspace_id})")
        print("-" * 78)
        print(f"{'PROVIDER':<9} {'MODE':<23} {'IDENTITY':<30} EXPIRES")
        expired = []
        for provider in SESSION_PROVIDERS:
            info = rows[provider]
            mode = info['mode']
            if mode == 'sso' and info['static_fallback']:
                mode += " (static fallback)"
            identity = info['identity'] or '-'
            if info['state'] == 'expired':
                expires = f"{info['expires_at']} (EXPIRED)"
                expired.append(provider)
            elif info['state'] == 'not logged in':
                expires = "not logged in"
            elif info.get('remaining'):
                expires = f"{info['expires_at']} ({info['remaining']} left)"
            elif info['state'] == 'active' and not info['expires_at']:
                expires = "provider-managed"
            else:
                expires = "-"
            print(f"{provider:<9} {mode:<23} {identity:<30} {expires}")

        for provider in expired:
            print(f"\n⚠️  {provider} session expired - re-login with: "
                  f"nubifer-creds login -t {provider}")
        print("\nResolution order: SSO session > static vault credentials "
              "(credential_process fallback)")


def handle_login_command(args):
    """Handle 'login' and 'login setup'"""
    session_manager = SessionManager(
        workspace_id=getattr(args, 'workspace', None))

    if getattr(args, 'login_command', None) == 'setup':
        session_manager.setup(args.type, {
            'sso_start_url': getattr(args, 'sso_start_url', None),
            'sso_region': getattr(args, 'sso_region', None),
            'sso_account_id': getattr(args, 'sso_account_id', None),
            'sso_role_name': getattr(args, 'sso_role_name', None),
            'role_arn': getattr(args, 'role_arn', None),
            'tenant': getattr(args, 'tenant', None),
            'subscription': getattr(args, 'subscription', None),
            'project': getattr(args, 'project', None),
            'impersonate_service_account':
                getattr(args, 'impersonate_service_account', None),
        })
        return

    if not getattr(args, 'type', None):
        print("✗ Provider required: nubifer-creds login -t {aws|azure|gcp}",
              file=sys.stderr)
        sys.exit(1)
    if not session_manager.login(args.type):
        sys.exit(1)


def handle_logout_command(args):
    session_manager = SessionManager(
        workspace_id=getattr(args, 'workspace', None))
    if not session_manager.logout(getattr(args, 'type', None)):
        sys.exit(1)


def handle_status_command(args):
    session_manager = SessionManager(
        workspace_id=getattr(args, 'workspace', None))
    session_manager.status(json_output=getattr(args, 'json', False))


def main():
    parser = argparse.ArgumentParser(description="NubiferOS Credential Manager")
    subparsers = parser.add_subparsers(dest="command", help="Commands")
    
    # Add command
    add_parser = subparsers.add_parser("add", help="Add credential")
    # db/ssh are planned types with no handlers yet — excluded from choices
    # so the CLI fails loudly instead of accepting and silently doing nothing
    add_parser.add_argument("-t", "--type", required=True, choices=["aws", "azure", "gcp", "api"],
                           help="Credential type")
    add_parser.add_argument("-n", "--name", required=True, help="Credential name")
    add_parser.add_argument("-w", "--workspace", help="Target workspace ID (defaults to active workspace)")
    add_parser.add_argument("-y", "--yes", action="store_true", help="Skip confirmation prompt")
    
    # AWS specific
    add_parser.add_argument("--access-key-id", help="AWS access key ID")
    add_parser.add_argument("--secret-access-key", help="AWS secret access key")
    add_parser.add_argument("--no-sts", action="store_true",
                           help="Disable STS token mode (use static credentials instead)")
    add_parser.add_argument("--sts-duration", type=int, default=3600,
                           help="STS token duration in seconds (default: 3600)")
    
    # Azure specific
    add_parser.add_argument("--tenant-id", help="Azure tenant ID")
    add_parser.add_argument("--client-id", help="Azure client ID")
    add_parser.add_argument("--client-secret", help="Azure client secret")
    
    # GCP specific
    add_parser.add_argument("--project-id", help="GCP project ID")
    add_parser.add_argument("--key-file", help="GCP service account key file")
    
    # API specific
    add_parser.add_argument("--token", help="API token")
    add_parser.add_argument("--scopes", help="API scopes")
    
    # List command
    list_parser = subparsers.add_parser("list", help="List credentials")
    list_parser.add_argument("-t", "--type", choices=["aws", "azure", "gcp", "api"],
                            help="Filter by type")
    
    # Get command
    get_parser = subparsers.add_parser("get", help="Get credential value")
    get_parser.add_argument("-t", "--type", required=True, choices=["aws", "azure", "gcp", "api"],
                           help="Credential type")
    get_parser.add_argument("-n", "--name", required=True, help="Credential name/profile")
    get_parser.add_argument("--json", action="store_true", help="Output as JSON")
    
    # Remove command
    remove_parser = subparsers.add_parser("remove", help="Remove credential")
    remove_parser.add_argument("path", help="Credential path (e.g., cloud/aws/profile-name)")

    # Token command (STS token management)
    token_parser = subparsers.add_parser("token", help="Manage STS temporary tokens")
    token_subparsers = token_parser.add_subparsers(dest="token_command", help="Token commands")

    # token enable
    token_enable = token_subparsers.add_parser("enable", help="Enable STS token mode for a credential")
    token_enable.add_argument("-t", "--type", required=True, choices=["aws"],
                              help="Credential type (only aws supported currently)")
    token_enable.add_argument("-n", "--name", required=True, help="Credential name/profile")
    token_enable.add_argument("-w", "--workspace", help="Workspace ID (defaults to active)")
    token_enable.add_argument("--duration", type=int, default=3600,
                              help="Token duration in seconds (900-43200, default: 3600)")

    # token disable
    token_disable = token_subparsers.add_parser("disable", help="Disable STS token mode")
    token_disable.add_argument("-t", "--type", required=True, choices=["aws"],
                               help="Credential type")
    token_disable.add_argument("-n", "--name", required=True, help="Credential name/profile")
    token_disable.add_argument("-w", "--workspace", help="Workspace ID (defaults to active)")

    # token status
    token_status = token_subparsers.add_parser("status", help="Show token status")
    token_status.add_argument("-t", "--type", required=True, choices=["aws"],
                              help="Credential type")
    token_status.add_argument("-n", "--name", required=True, help="Credential name/profile")
    token_status.add_argument("-w", "--workspace", help="Workspace ID (defaults to active)")
    token_status.add_argument("--json", action="store_true", help="Output as JSON")

    # token clear
    token_clear = token_subparsers.add_parser("clear", help="Clear cached token")
    token_clear.add_argument("-t", "--type", required=True, choices=["aws"],
                             help="Credential type")
    token_clear.add_argument("-n", "--name", required=True, help="Credential name/profile")
    token_clear.add_argument("-w", "--workspace", help="Workspace ID (defaults to active)")

    # token refresh
    token_refresh = token_subparsers.add_parser("refresh", help="Force refresh cached token")
    token_refresh.add_argument("-t", "--type", required=True, choices=["aws"],
                               help="Credential type")
    token_refresh.add_argument("-n", "--name", required=True, help="Credential name/profile")
    token_refresh.add_argument("-w", "--workspace", help="Workspace ID (defaults to active)")

    # Login command (guided SSO login inside the workspace scope)
    login_parser = subparsers.add_parser(
        "login", help="Log in to a cloud provider for the active workspace (SSO)")
    login_parser.add_argument("-t", "--type", choices=["aws", "azure", "gcp"],
                              help="Provider to log in to (required)")
    login_parser.add_argument("-w", "--workspace",
                              help="Workspace ID (defaults to active)")
    login_subparsers = login_parser.add_subparsers(dest="login_command")

    # login setup - store non-secret SSO configuration / role bindings
    login_setup = login_subparsers.add_parser(
        "setup", help="Store non-secret SSO configuration and role bindings")
    login_setup.add_argument("-t", "--type", required=True,
                             choices=["aws", "azure", "gcp"],
                             help="Provider to configure")
    login_setup.add_argument("-w", "--workspace",
                             help="Workspace ID (defaults to active)")
    # AWS IAM Identity Center
    login_setup.add_argument("--sso-start-url", help="AWS SSO start URL")
    login_setup.add_argument("--sso-region", help="AWS SSO region")
    login_setup.add_argument("--sso-account-id", help="AWS account ID for SSO")
    login_setup.add_argument("--sso-role-name", help="AWS permission set / role name")
    login_setup.add_argument("--role-arn",
                             help="AWS IAM role ARN to assume (role binding)")
    # Azure Entra ID
    login_setup.add_argument("--tenant", help="Azure tenant (applied at az login)")
    login_setup.add_argument("--subscription",
                             help="Azure subscription (az account set after login)")
    # GCP
    login_setup.add_argument("--project", help="GCP project for the workspace")
    login_setup.add_argument("--impersonate-service-account",
                             help="GCP service account to impersonate")

    # Logout command
    logout_parser = subparsers.add_parser(
        "logout", help="Log out provider sessions for the active workspace")
    logout_parser.add_argument("-t", "--type", choices=["aws", "azure", "gcp"],
                               help="Provider (default: all recorded sessions)")
    logout_parser.add_argument("-w", "--workspace",
                               help="Workspace ID (defaults to active)")

    # Status command (per-provider session table)
    status_parser = subparsers.add_parser(
        "status", help="Per-provider session status: mode, identity, expiry")
    status_parser.add_argument("-w", "--workspace",
                               help="Workspace ID (defaults to active)")
    status_parser.add_argument("--json", action="store_true",
                               help="Output as JSON")

    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return

    # Session commands (SSO) never touch the pass vault - dispatch before
    # constructing CredentialManager so they work without an initialized
    # password store. Static-key commands below are unchanged.
    if args.command == "login":
        handle_login_command(args)
        return
    if args.command == "logout":
        handle_logout_command(args)
        return
    if args.command == "status":
        handle_status_command(args)
        return

    manager = CredentialManager()
    
    if args.command == "add":
        # Use specified workspace or active workspace
        workspace_override = getattr(args, 'workspace', None)
        if workspace_override:
            manager = CredentialManager(workspace=workspace_override)
        
        # Confirm workspace before adding credentials
        skip_confirm = getattr(args, 'yes', False)
        if not skip_confirm:
            print(f"\n⚠️  You are adding credentials to workspace:")
            print(f"   Name: {manager.backend.workspace_name}")
            print(f"   ID:   {manager.backend.workspace}")
            print()
            confirm = input("Continue? [y/N]: ").strip().lower()
            if confirm not in ('y', 'yes'):
                print("Cancelled.")
                sys.exit(0)
            print()
        
        if args.type == "aws":
            if not args.access_key_id:
                args.access_key_id = input("AWS Access Key ID: ")
            if not args.secret_access_key:
                args.secret_access_key = getpass.getpass("AWS Secret Access Key: ")

            enable_sts = not getattr(args, 'no_sts', False)
            sts_duration = getattr(args, 'sts_duration', 3600)

            manager.add_aws_credentials(args.name, args.access_key_id, args.secret_access_key,
                                       enable_sts=enable_sts, sts_duration=sts_duration)
        
        elif args.type == "azure":
            if not args.tenant_id:
                args.tenant_id = input("Azure Tenant ID: ")
            if not args.client_id:
                args.client_id = input("Azure Client ID: ")
            if not args.client_secret:
                args.client_secret = getpass.getpass("Azure Client Secret: ")
            
            manager.add_azure_credentials(args.name, args.tenant_id, args.client_id, args.client_secret)
        
        elif args.type == "gcp":
            if not args.project_id:
                args.project_id = input("GCP Project ID: ")
            if not args.key_file:
                args.key_file = input("GCP Service Account Key File: ")
            
            manager.add_gcp_credentials(args.name, args.project_id, args.key_file)
        
        elif args.type == "api":
            if not args.token:
                args.token = getpass.getpass(f"{args.name} API Token: ")
            
            manager.add_api_token(args.name, args.token, args.scopes or "")
    
    elif args.command == "list":
        manager.list_credentials(cred_type=args.type)
    
    elif args.command == "get":
        if args.type == "aws":
            creds = manager.get_aws_credentials(args.name)
            if creds:
                if args.json:
                    print(json.dumps(creds, indent=2))
                else:
                    print(f"AWS Credentials: {args.name}")
                    print(f"  Access Key ID: {creds['access_key_id']}")
                    print(f"  Secret Access Key: {creds['secret_access_key'][:4]}...{creds['secret_access_key'][-4:]}")
                    print(f"  (Region is set on workspace, not credential)")
            else:
                print(f"✗ Credentials not found: {args.name}", file=sys.stderr)
                sys.exit(1)
        elif args.type == "azure":
            creds = manager.get_azure_credentials(args.name)
            if creds:
                if args.json:
                    print(json.dumps(creds, indent=2))
                else:
                    print(f"Azure Credentials: {args.name}")
                    print(f"  Tenant ID: {creds['tenant_id']}")
                    print(f"  Client ID: {creds['client_id']}")
                    print(f"  Client Secret: {creds['client_secret'][:4]}...{creds['client_secret'][-4:]}")
            else:
                print(f"✗ Credentials not found: {args.name}", file=sys.stderr)
                sys.exit(1)
        elif args.type == "gcp":
            creds = manager.get_gcp_credentials(args.name)
            if creds:
                if args.json:
                    print(json.dumps(creds, indent=2))
                else:
                    print(f"GCP Credentials: {args.name}")
                    print(f"  Project ID: {creds['project_id']}")
                    print(f"  Service Account Key: [stored]")
            else:
                print(f"✗ Credentials not found: {args.name}", file=sys.stderr)
                sys.exit(1)
        elif args.type == "api":
            creds = manager.get_api_token(args.name)
            if creds:
                if args.json:
                    print(json.dumps(creds, indent=2))
                else:
                    print(f"API Token: {args.name}")
                    print(f"  Token: {creds['token'][:4]}...{creds['token'][-4:]}")
                    if creds.get('scopes'):
                        print(f"  Scopes: {creds['scopes']}")
            else:
                print(f"✗ Token not found: {args.name}", file=sys.stderr)
                sys.exit(1)

    elif args.command == "remove":
        manager.remove_credential(args.path)

    elif args.command == "token":
        handle_token_command(args)


def handle_token_command(args):
    """Handle token subcommands"""
    if not args.token_command:
        print("Usage: nubifer-creds token {enable|disable|status|clear|refresh} ...")
        print("Run 'nubifer-creds token -h' for help")
        sys.exit(1)

    # Get workspace
    workspace = getattr(args, 'workspace', None) or os.getenv("NUBIFER_WORKSPACE_ID", "default")
    cred_type = args.type
    cred_name = args.name

    try:
        from token_cache import TokenCache
        cache = TokenCache()
    except ImportError as e:
        print(f"Error: Token cache module not available: {e}", file=sys.stderr)
        print("Install required dependencies: pip install keyring cryptography boto3")
        sys.exit(1)

    if args.token_command == "enable":
        duration = getattr(args, 'duration', 3600)

        # Validate duration
        if duration < 900:
            print("Warning: Minimum duration is 900 seconds (15 minutes), using 900")
            duration = 900
        elif duration > 43200:
            print("Warning: Maximum duration is 43200 seconds (12 hours), using 43200")
            duration = 43200

        # Check if base credentials exist
        base_path = f"nubifer/{workspace}/cloud/{cred_type}/{cred_name}"
        try:
            result = subprocess.run(
                ["pass", "show", f"{base_path}/access-key-id"],
                capture_output=True,
                text=True,
                timeout=10
            )
            if result.returncode != 0:
                print(f"Error: Base credentials not found for '{cred_name}' in workspace '{workspace}'")
                print(f"Add credentials first: nubifer-creds add -t {cred_type} -n {cred_name}")
                sys.exit(1)
        except Exception as e:
            print(f"Error checking credentials: {e}", file=sys.stderr)
            sys.exit(1)

        if cache.enable_token_mode(workspace, cred_type, cred_name, duration):
            print(f"Token mode enabled: {cred_type}/{cred_name}")
            print(f"  Workspace: {workspace}")
            print(f"  Duration: {duration} seconds ({duration // 60} minutes)")
            print()
            print("STS tokens will be automatically generated and cached.")
            print("Tokens refresh automatically when expired or within 5 minutes of expiry.")
        else:
            print("Failed to enable token mode", file=sys.stderr)
            sys.exit(1)

    elif args.token_command == "disable":
        if cache.disable_token_mode(workspace, cred_type, cred_name):
            print(f"Token mode disabled: {cred_type}/{cred_name}")
            print("Static credentials will be used for future requests.")
        else:
            print("Failed to disable token mode", file=sys.stderr)
            sys.exit(1)

    elif args.token_command == "status":
        settings = cache.get_token_settings(workspace, cred_type, cred_name)

        if getattr(args, 'json', False):
            if settings:
                print(json.dumps(settings, indent=2))
            else:
                print(json.dumps({"enabled": False}))
            return

        print(f"Token Status: {cred_type}/{cred_name}")
        print(f"  Workspace: {workspace}")
        print("-" * 40)

        if not settings:
            print("  Token mode: disabled (never configured)")
            return

        print(f"  Token mode: {'enabled' if settings['enabled'] else 'disabled'}")
        print(f"  Duration: {settings['duration_seconds']} seconds")

        if settings.get('token_expires_at'):
            remaining = settings.get('token_remaining_seconds', 0)
            if remaining > 0:
                mins = remaining // 60
                secs = remaining % 60
                print(f"  Cached token: valid ({mins}m {secs}s remaining)")
                print(f"  Expires: {settings['token_expires_at']}")
                print(f"  Storage: {settings.get('storage_type', 'unknown')}")
            else:
                print("  Cached token: expired")
        else:
            print("  Cached token: none")

    elif args.token_command == "clear":
        if cache.clear_token(workspace, cred_type, cred_name):
            print(f"Token cache cleared: {cred_type}/{cred_name}")
            print("A new token will be generated on next use.")
        else:
            print("Failed to clear token cache", file=sys.stderr)
            sys.exit(1)

    elif args.token_command == "refresh":
        # Clear existing cache and force regeneration
        cache.clear_token(workspace, cred_type, cred_name)

        if not cache.is_token_enabled(workspace, cred_type, cred_name):
            print(f"Error: Token mode not enabled for {cred_type}/{cred_name}")
            print(f"Enable first: nubifer-creds token enable -t {cred_type} -n {cred_name}")
            sys.exit(1)

        try:
            from token_generators.aws import AWSTokenGenerator, AWSTokenGeneratorError
            generator = AWSTokenGenerator(workspace)
            duration = cache.get_duration_seconds(workspace, cred_type, cred_name)

            print(f"Generating new STS token for {cred_type}/{cred_name}...")
            token_data, expiration = generator.get_session_token(cred_name, duration_seconds=duration)

            if token_data and expiration:
                cache.store_token(workspace, cred_type, cred_name, token_data, expiration)
                print(f"Token refreshed successfully")
                print(f"  Expires: {expiration.isoformat()}")
            else:
                print("Failed to generate token", file=sys.stderr)
                sys.exit(1)

        except AWSTokenGeneratorError as e:
            print(f"Token generation failed: {e}", file=sys.stderr)
            sys.exit(1)
        except ImportError as e:
            print(f"Error: boto3 not installed: {e}", file=sys.stderr)
            print("Install with: pip install boto3")
            sys.exit(1)


if __name__ == "__main__":
    main()
