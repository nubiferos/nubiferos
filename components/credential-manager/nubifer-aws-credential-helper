#!/usr/bin/env python3
"""
NubiferOS AWS Credential Helper
Used by AWS CLI credential_process to retrieve credentials from pass

Supports two modes:
1. Static credentials: Returns base credentials from pass
2. Token mode: Returns cached STS tokens, auto-refreshing on expiry
"""

import json
import subprocess
import sys
import os

# Add src directory to path for imports
# Check installed location first, then development location
installed_path = '/usr/local/lib/nubifer/credential-manager/src'
dev_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'src')
if os.path.isdir(installed_path):
    sys.path.insert(0, installed_path)
else:
    sys.path.insert(0, dev_path)


def get_credential_from_pass(path):
    """Retrieve a single credential from pass"""
    try:
        result = subprocess.run(
            ["pass", "show", path],
            capture_output=True,
            text=True,
            timeout=10
        )
        if result.returncode == 0:
            return result.stdout.strip()
        return None
    except Exception:
        return None


def get_static_credentials(workspace, cred_name):
    """Get static credentials from pass (original behavior)"""
    base_path = f"nubifer/{workspace}/cloud/aws/{cred_name}"

    access_key = get_credential_from_pass(f"{base_path}/access-key-id")
    secret_key = get_credential_from_pass(f"{base_path}/secret-access-key")

    if not access_key or not secret_key:
        return None

    output = {
        "Version": 1,
        "AccessKeyId": access_key,
        "SecretAccessKey": secret_key
    }

    # Optional: session token if present (for manually stored tokens)
    session_token = get_credential_from_pass(f"{base_path}/session-token")
    if session_token:
        output["SessionToken"] = session_token

    return output


def get_token_credentials(workspace, cred_name):
    """Get STS token credentials with caching"""
    try:
        from token_cache import TokenCache
        from token_generators.aws import AWSTokenGenerator, AWSTokenGeneratorError

        cache = TokenCache()

        # Check if token mode is enabled
        if not cache.is_token_enabled(workspace, 'aws', cred_name):
            return None  # Fall back to static credentials

        # Try to get cached token
        token = cache.get_token(workspace, 'aws', cred_name)

        if token:
            # Cache hit - return cached token
            return {
                "Version": 1,
                "AccessKeyId": token['AccessKeyId'],
                "SecretAccessKey": token['SecretAccessKey'],
                "SessionToken": token['SessionToken']
            }

        # Cache miss - generate new token
        duration = cache.get_duration_seconds(workspace, 'aws', cred_name)
        generator = AWSTokenGenerator(workspace)

        try:
            token_data, expiration = generator.get_session_token(
                cred_name,
                duration_seconds=duration
            )

            if token_data and expiration:
                # Store in cache
                cache.store_token(workspace, 'aws', cred_name, token_data, expiration)

                return {
                    "Version": 1,
                    "AccessKeyId": token_data['AccessKeyId'],
                    "SecretAccessKey": token_data['SecretAccessKey'],
                    "SessionToken": token_data['SessionToken']
                }

        except AWSTokenGeneratorError as e:
            # Log error but fall back to static credentials
            print(json.dumps({
                "Version": 1,
                "Code": "TokenGenerationWarning",
                "Message": f"STS token generation failed, using static credentials: {e}"
            }), file=sys.stderr)
            return None

    except ImportError as e:
        # Token cache modules not available, fall back to static credentials
        pass

    return None


def main():
    # Get workspace and credential name from environment or args
    workspace = os.environ.get("NUBIFER_WORKSPACE", "default")

    # Credential name can be passed as arg or from environment
    if len(sys.argv) > 1:
        cred_name = sys.argv[1]
    else:
        cred_name = os.environ.get("NUBIFER_AWS_CREDENTIAL", "default")

    # Try token mode first (if enabled)
    output = get_token_credentials(workspace, cred_name)

    # Fall back to static credentials if token mode not enabled or failed
    if not output:
        output = get_static_credentials(workspace, cred_name)

    if not output:
        print(json.dumps({
            "Version": 1,
            "Code": "CredentialRetrievalError",
            "Message": f"Failed to retrieve credentials for '{cred_name}' in workspace '{workspace}'"
        }), file=sys.stderr)
        sys.exit(1)

    print(json.dumps(output))


if __name__ == "__main__":
    main()
