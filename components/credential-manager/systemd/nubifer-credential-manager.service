[Unit]
Description=NubiferOS Credential Manager D-Bus Service
Documentation=file:///usr/local/lib/nubiferos/credential-manager/README.md
After=dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.nubiferos.CredentialManager
ExecStart=/usr/local/bin/nubifer-creds-service
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.password-store %h/.config/nubiferos

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nubifer-credential-manager

[Install]
WantedBy=default.target
