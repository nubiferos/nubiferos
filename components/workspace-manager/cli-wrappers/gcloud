#!/bin/bash
# NubiferOS Google Cloud CLI Wrapper
# Provides workspace isolation and read-only mode enforcement

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIREJAIL_WRAPPER="${SCRIPT_DIR}/../firejail-wrapper.sh"

# Load audit trail
source /etc/nubifer/audit-functions.sh 2>/dev/null

# Check if workspace is active
if [ -z "$NUBIFER_WORKSPACE_ID" ]; then
    echo "⚠️  No active workspace. Running gcloud without isolation." >&2
    echo "   Activate workspace: nubifer-workspace switch <workspace-id>" >&2
    _nubifer_audit_log gcp no_workspace "$@" 2>/dev/null
    exec /usr/bin/gcloud "$@"
fi

# Check read-only mode
if [ "$NUBIFER_WORKSPACE_READ_ONLY" = "true" ]; then
    # Write verbs that modify resources
    write_verbs="create|delete|update|set|add|remove|start|stop|reset|move|resize|attach|detach|deploy|undeploy|import|export|enable|disable|invoke|run|apply|destroy|suspend|resume|patch|insert|cancel|submit"

    # gcloud commands use: gcloud <group> <subgroup>... <verb>
    # Check if any argument is a write verb (word boundary match)
    if echo "$*" | grep -qwE "($write_verbs)"; then
        echo "" >&2
        echo -e "\033[48;5;22;97m 🔒 WRITE BLOCKED \033[0m Workspace is in read-only mode" >&2
        echo "" >&2
        echo "  Command: gcloud $*" >&2
        echo "" >&2
        echo "  To enable writes (requires sudo):" >&2
        echo "    sudo nubifer-workspace rw $NUBIFER_WORKSPACE_ID" >&2
        echo "" >&2
        echo "  For timed write access (auto-reverts):" >&2
        echo "    sudo nubifer-workspace rw $NUBIFER_WORKSPACE_ID -d 30  # 30 minutes" >&2
        echo "" >&2
        _nubifer_audit_log gcp blocked "$@" 2>/dev/null
        exit 1
    fi
fi

# Expired-session hint (modern-cloud-auth Req 2.4): if the workspace has a
# recorded GCP SSO session whose expiry is past, print a one-line re-login
# hint. Never blocks the command — gcloud gives its own error if needed.
WORKSPACE_FILE="$HOME/.config/nubifer/workspaces/${NUBIFER_WORKSPACE_ID}.json"
if [ -f "$WORKSPACE_FILE" ]; then
    SESSION_EXPIRED=$(python3 - "$WORKSPACE_FILE" gcp 2>/dev/null << 'PYEOF'
import json, sys
from datetime import datetime, timezone
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    data = {}
session = (data.get('sessions') or {}).get(sys.argv[2]) or {}
ts = (session.get('expires_at') or '').strip()
if ts.endswith('Z'):
    ts = ts[:-1] + '+00:00'
elif ts.endswith('UTC'):
    ts = ts[:-3] + '+00:00'
expired = 'no'
if ts:
    try:
        parsed = datetime.fromisoformat(ts)
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=timezone.utc)
        if parsed <= datetime.now(timezone.utc):
            expired = 'yes'
    except ValueError:
        pass
print(expired)
PYEOF
    )
    if [ "$SESSION_EXPIRED" = "yes" ]; then
        echo "⚠️  Workspace '${NUBIFER_WORKSPACE_NAME:-$NUBIFER_WORKSPACE_ID}': GCP session expired — run: nubifer-creds login -t gcp" >&2
    fi
fi

# Log allowed command
_nubifer_audit_log gcp allowed "$@" 2>/dev/null

# Run with Firejail isolation
if [ -x "$FIREJAIL_WRAPPER" ]; then
    exec "$FIREJAIL_WRAPPER" gcp /usr/bin/gcloud "$@"
else
    exec /usr/bin/gcloud "$@"
fi
