#!/bin/bash
# NubiferOS Oracle Cloud CLI Wrapper
# Provides workspace isolation and read-only mode enforcement

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIREJAIL_WRAPPER="${SCRIPT_DIR}/../firejail-wrapper.sh"

# Check if workspace is active
if [ -z "$NUBIFER_WORKSPACE_ID" ]; then
    echo "⚠️  No active workspace. Running OCI CLI without isolation." >&2
    echo "   Activate workspace: eval \$(nubifer-workspace env <workspace-id>)" >&2
    exec /usr/local/bin/oci "$@"
fi

# Check read-only mode
if [ "$NUBIFER_WORKSPACE_READ_ONLY" = "true" ]; then
    # Check if command is a write operation
    write_commands="create|delete|update|terminate|start|stop|reset|change|move"
    
    if echo "$*" | grep -qE "$write_commands"; then
        echo "✗ Oracle Cloud write operation blocked: Workspace is in read-only mode 🔒" >&2
        echo "  Command: oci $*" >&2
        echo "  Disable read-only: nubifer-workspace readonly $NUBIFER_WORKSPACE_ID --disable" >&2
        exit 1
    fi
fi

# Run with Firejail isolation
if [ -x "$FIREJAIL_WRAPPER" ]; then
    exec "$FIREJAIL_WRAPPER" oracle /usr/local/bin/oci "$@"
else
    # Fallback if wrapper not found
    exec /usr/local/bin/oci "$@"
fi
