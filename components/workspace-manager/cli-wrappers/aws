#!/bin/bash
# NubiferOS AWS CLI Wrapper
# Provides workspace isolation, credential injection, and read-only mode enforcement

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIREJAIL_WRAPPER="${SCRIPT_DIR}/../firejail-wrapper.sh"

# Load audit trail
source /etc/nubifer/audit-functions.sh 2>/dev/null

# Check if workspace is active
if [ -z "$NUBIFER_WORKSPACE_ID" ]; then
    echo "⚠️  No active workspace. Running AWS CLI without isolation." >&2
    echo "   Activate workspace: nubifer-workspace switch <workspace-id>" >&2
    _nubifer_audit_log aws no_workspace "$@" 2>/dev/null
    exec /usr/bin/aws "$@"
fi

# Check read-only mode
if [ "$NUBIFER_WORKSPACE_READ_ONLY" = "true" ]; then
    # Check if command is a write operation
    # Generic write verbs
    write_verbs="create|delete|update|put|modify|terminate|stop|start|reboot|attach|detach|associate|disassociate|enable|disable|register|deregister|remove|add|set|import|copy|move|upload|write|invoke|execute|run|send|publish|tag|untag"
    
    # S3-specific shorthand commands that are writes
    s3_write_commands="mb|rb|cp|mv|rm|sync"
    
    # Check for generic write verbs
    if echo "$*" | grep -qiE "\b($write_verbs)\b"; then
        echo "" >&2
        echo -e "\033[48;5;22;97m 🔒 WRITE BLOCKED \033[0m Workspace is in read-only mode" >&2
        echo "" >&2
        echo "  Command: aws $*" >&2
        echo "" >&2
        echo "  To enable writes (requires sudo):" >&2
        echo "    sudo nubifer-workspace rw $NUBIFER_WORKSPACE_ID" >&2
        echo "" >&2
        echo "  For timed write access (auto-reverts):" >&2
        echo "    sudo nubifer-workspace rw $NUBIFER_WORKSPACE_ID -d 30  # 30 minutes" >&2
        echo "" >&2
        _nubifer_audit_log aws blocked "$@" 2>/dev/null
        exit 1
    fi

    # Check for S3 shorthand write commands (mb=make bucket, rb=remove bucket, etc.)
    if echo "$*" | grep -qE "^s3\s+($s3_write_commands)\b"; then
        echo "" >&2
        echo -e "\033[48;5;22;97m 🔒 WRITE BLOCKED \033[0m Workspace is in read-only mode" >&2
        echo "" >&2
        echo "  Command: aws $*" >&2
        echo "  (S3 write operation: mb=make bucket, rb=remove bucket, cp=copy, mv=move, rm=remove, sync=sync)" >&2
        echo "" >&2
        echo "  To enable writes (requires sudo):" >&2
        echo "    sudo nubifer-workspace rw $NUBIFER_WORKSPACE_ID" >&2
        echo "" >&2
        echo "  For timed write access (auto-reverts):" >&2
        echo "    sudo nubifer-workspace rw $NUBIFER_WORKSPACE_ID -d 30  # 30 minutes" >&2
        echo "" >&2
        _nubifer_audit_log aws blocked "$@" 2>/dev/null
        exit 1
    fi
fi

# Workspace config JSON (non-secret: region, SSO config, session metadata)
WORKSPACE_FILE="$HOME/.config/nubifer/workspaces/${NUBIFER_WORKSPACE_ID}.json"

# Modern auth check (SSO / role bindings — modern-cloud-auth Req 2.4/4.1)
# When the workspace carries SSO configuration, a role binding, or a recorded
# SSO session, the Session Broker's scoped AWS config (exported as
# AWS_CONFIG_FILE by shell integration) already resolves SSO-first with the
# 'nubifer-static' credential_process profile as the documented fallback.
# In that case this wrapper must NOT override AWS_CONFIG_FILE with its own
# static temp config. Also detect an expired recorded session so we can
# print a re-login hint (never blocking — the AWS CLI gives its own error).
MODERN_AUTH="no"
SESSION_EXPIRED="no"
if [ -f "$WORKSPACE_FILE" ]; then
    MODERN_INFO=$(python3 - "$WORKSPACE_FILE" 2>/dev/null << 'PYEOF'
import json, sys
from datetime import datetime, timezone
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    data = {}
sso = (data.get('sso') or {}).get('aws') or {}
session = (data.get('sessions') or {}).get('aws') or {}
modern = 'yes' if (sso or data.get('aws_role_arn') or session) else 'no'
expired = 'no'
ts = (session.get('expires_at') or '').strip()
if ts.endswith('Z'):
    ts = ts[:-1] + '+00:00'
elif ts.endswith('UTC'):
    ts = ts[:-3] + '+00:00'
if ts:
    try:
        parsed = datetime.fromisoformat(ts)
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=timezone.utc)
        if parsed <= datetime.now(timezone.utc):
            expired = 'yes'
    except ValueError:
        pass
print(modern, expired)
PYEOF
    )
    case "$MODERN_INFO" in
        yes*) MODERN_AUTH="yes" ;;
    esac
    case "$MODERN_INFO" in
        *yes) SESSION_EXPIRED="yes" ;;
    esac
fi

if [ "$MODERN_AUTH" = "yes" ]; then
    # SSO / role passthrough: leave AWS_CONFIG_FILE alone so the broker's
    # scoped config resolves the session (SSO > static, Req 4.1)
    if [ "$SESSION_EXPIRED" = "yes" ]; then
        echo "⚠️  Workspace '${NUBIFER_WORKSPACE_NAME:-$NUBIFER_WORKSPACE_ID}': AWS session expired — run: nubifer-creds login -t aws" >&2
    fi

    # Workspace context for the credential helper ('nubifer-static' fallback
    # profile in the scoped config still uses credential_process)
    export NUBIFER_WORKSPACE="$NUBIFER_WORKSPACE_ID"

    # Disable AWS pager to prevent terminal corruption on Ctrl+C
    export AWS_PAGER=""

    # Log allowed command
    _nubifer_audit_log aws allowed "$@" 2>/dev/null

    # Run with Firejail isolation if available
    if [ -x "$FIREJAIL_WRAPPER" ]; then
        exec "$FIREJAIL_WRAPPER" aws /usr/bin/aws "$@"
    else
        exec /usr/bin/aws "$@"
    fi
fi

# ---------------------------------------------------------------------------
# Static-only path (legacy fallback — unchanged behavior, Req 4.1)
# ---------------------------------------------------------------------------

# Get credential name for this workspace (default to workspace name or 'default')
CRED_NAME="${NUBIFER_AWS_CREDENTIAL:-${NUBIFER_WORKSPACE_NAME:-default}}"

# Check if credentials exist in pass for this workspace
# Use file existence check instead of pass show (avoids GPG decryption/pinentry hang)
PASS_STORE="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
PASS_FILE="${PASS_STORE}/nubifer/${NUBIFER_WORKSPACE_ID}/cloud/aws/${CRED_NAME}/access-key-id.gpg"
if [ ! -f "$PASS_FILE" ]; then
    # Try with 'default' credential name
    PASS_FILE="${PASS_STORE}/nubifer/${NUBIFER_WORKSPACE_ID}/cloud/aws/default/access-key-id.gpg"
    if [ ! -f "$PASS_FILE" ]; then
        echo "⚠️  No AWS credentials found for workspace." >&2
        echo "   Add credentials: nubifer-creds add -t aws -n <profile-name>" >&2
        echo "   Running without credentials..." >&2
        exec /usr/bin/aws "$@"
    fi
    CRED_NAME="default"
fi

# Get region from workspace config (not pass - region is context, not a secret)
REGION=""
if [ -f "$WORKSPACE_FILE" ]; then
    # Try top-level 'region' first, then fall back to environment.AWS_REGION
    REGION=$(python3 -c "
import json
data = json.load(open('$WORKSPACE_FILE'))
region = data.get('region')
if not region:
    region = data.get('environment', {}).get('AWS_REGION')
print(region if region else '')
" 2>/dev/null)
fi
REGION="${REGION:-us-east-1}"

# Inject credentials securely using credential_process
# This avoids putting credentials in environment variables
AWS_CONFIG_FILE=$(mktemp)
export AWS_CONFIG_FILE
trap 'rm -f "$AWS_CONFIG_FILE"' EXIT

cat > "$AWS_CONFIG_FILE" << EOF
[default]
credential_process = /usr/local/bin/nubifer-aws-credential-helper ${CRED_NAME}
region = ${REGION}
EOF

# Set workspace environment for credential helper
export NUBIFER_WORKSPACE="$NUBIFER_WORKSPACE_ID"

# Pre-warm GPG agent so credential_process (no terminal) can decrypt
# The wrapper runs in the user's terminal, so pinentry can prompt here.
# Once cached, the credential helper subprocess won't need to prompt.
export GPG_TTY=$(tty 2>/dev/null || echo "${GPG_TTY:-}")
pass show "nubifer/${NUBIFER_WORKSPACE_ID}/cloud/aws/${CRED_NAME}/access-key-id" >/dev/null 2>&1 || \
    pass show "nubifer/${NUBIFER_WORKSPACE_ID}/cloud/aws/${CRED_NAME}/access-key-id" >/dev/null

# Disable AWS pager to prevent terminal corruption on Ctrl+C
# Users can re-enable with: export AWS_PAGER="less"
export AWS_PAGER=""

# Log allowed command
_nubifer_audit_log aws allowed "$@" 2>/dev/null

# Run with Firejail isolation if available
if [ -x "$FIREJAIL_WRAPPER" ]; then
    exec "$FIREJAIL_WRAPPER" aws /usr/bin/aws "$@"
else
    exec /usr/bin/aws "$@"
fi
