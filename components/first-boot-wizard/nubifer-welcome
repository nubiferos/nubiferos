class WelcomeWizard(Adw.ApplicationWindow):
    """Main wizard window"""

    def __init__(self, app):
        super().__init__(application=app, title="Welcome to NubiferOS")

        self.set_default_size(700, 600)
        self.set_resizable(False)

        # Main box
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        # Header bar
        header = Adw.HeaderBar()
        header.set_show_end_title_buttons(True)
        main_box.append(header)

        # Content area
        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content_box.set_vexpand(True)

        # Stack for pages
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_vexpand(True)

        # Create pages
        self.welcome_page = WelcomePage()
        self.cloud_page = CloudSetupPage()
        self.cred_page = CredentialSetupPage()
        self.workspace_page = WorkspacePage()
        self.complete_page = CompletePage()

        self.stack.add_named(self.welcome_page, "welcome")
        self.stack.add_named(self.cloud_page, "cloud")
        self.stack.add_named(self.cred_page, "credentials")
        self.stack.add_named(self.workspace_page, "workspace")
        self.stack.add_named(self.complete_page, "complete")

        content_box.append(self.stack)
        main_box.append(content_box)

        # Navigation buttons
        nav_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        nav_box.set_margin_top(12)
        nav_box.set_margin_bottom(24)
        nav_box.set_margin_start(24)
        nav_box.set_margin_end(24)
        nav_box.set_halign(Gtk.Align.END)

        self.skip_button = Gtk.Button(label="Skip")
        self.skip_button.connect("clicked", self._on_skip)
        nav_box.append(self.skip_button)

        self.back_button = Gtk.Button(label="Back")
        self.back_button.connect("clicked", self._on_back)
        self.back_button.set_sensitive(False)
        nav_box.append(self.back_button)

        self.next_button = Gtk.Button(label="Get Started")
        self.next_button.add_css_class("suggested-action")
        self.next_button.connect("clicked", self._on_next)
        nav_box.append(self.next_button)

        main_box.append(nav_box)

        self.set_content(main_box)

        # Track pages
        self.pages = ["welcome", "cloud", "credentials", "workspace", "complete"]
        self.current_page = 0

    def _update_nav_buttons(self):
        """Update navigation buttons based on current page"""
        self.back_button.set_sensitive(self.current_page > 0)

        if self.current_page == len(self.pages) - 1:
            self.next_button.set_label("Done")
            self.skip_button.set_visible(False)
        elif self.current_page == 0:
            self.next_button.set_label("Get Started")
            self.skip_button.set_visible(True)
        else:
            self.next_button.set_label("Next")
            self.skip_button.set_visible(True)

    def _on_next(self, button):
        """Handle next button click"""
        if self.current_page < len(self.pages) - 1:
            self.current_page += 1
            self.stack.set_visible_child_name(self.pages[self.current_page])
            self._update_nav_buttons()
        else:
            self._finish_setup()

    def _on_back(self, button):
        """Handle back button click"""
        if self.current_page > 0:
            self.current_page -= 1
            self.stack.set_visible_child_name(self.pages[self.current_page])
            self._update_nav_buttons()

    def _on_skip(self, button):
        """Handle skip button - go directly to finish"""
        self._finish_setup()

    def _finish_setup(self):
        """Mark setup as complete and close"""
        # Create config directory and flag file
        config_dir = os.path.dirname(SETUP_COMPLETE_FLAG)
        os.makedirs(config_dir, exist_ok=True)

        with open(SETUP_COMPLETE_FLAG, 'w') as f:
            f.write(f"Setup completed on: {GLib.DateTime.new_now_local().format('%Y-%m-%d %H:%M:%S')}\n")
            f.write(f"Selected providers: {','.join(self.cloud_page.get_selected_providers())}\n")

        self.close()


class WelcomeApp(Adw.Application):
    """Main application"""

    def __init__(self):
        super().__init__(
            application_id='io.nubiferos.Welcome',
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )

    def do_activate(self):
        """Create and show the main window"""
        win = WelcomeWizard(self)
        win.present()


def is_live_environment():
    """Check if we're running in the live installer environment"""
    # Check for live boot indicators
    live_indicators = [
        "/run/live/medium",           # Live boot squashfs mount
        "/run/live/rootfs",           # Live boot rootfs
        "/lib/live/mount",            # Debian live mount point
        "/etc/calamares",             # Calamares installer present
    ]
    
    for indicator in live_indicators:
        if os.path.exists(indicator):
            return True
    
    # Check if running as 'installer' user (live environment user)
    if os.getenv("USER") == "installer":
        return True
    
    # Check for live boot kernel parameter
    try:
        with open("/proc/cmdline", "r") as f:
            cmdline = f.read()
            if "boot=live" in cmdline:
                return True
    except:
        pass
    
    return False


def main():
    # Don't run in live/installer environment
    if is_live_environment():
        print("Running in live installer environment - skipping first-boot wizard.")
        sys.exit(0)
    
    # Check if setup already complete
    if os.path.exists(SETUP_COMPLETE_FLAG) and "--force" not in sys.argv:
        print("Setup already complete. Run with --force to show wizard again.")
        sys.exit(0)

    app = WelcomeApp()
    app.run(sys.argv)


if __name__ == "__main__":
    main()
