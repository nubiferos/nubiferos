                  "You can configure credentials later using nubifer-creds."
        )
        desc.set_wrap(True)
        desc.set_justify(Gtk.Justification.CENTER)
        desc.add_css_class("dim-label")
        self.append(desc)

        # Cloud provider checkboxes
        self.providers_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.providers_box.set_margin_top(24)
        self.providers_box.set_halign(Gtk.Align.CENTER)

        self.aws_check = self._create_provider_row(
            "Amazon Web Services (AWS)",
            "aws, kubectl, terraform",
            True  # Default enabled
        )
        self.gcp_check = self._create_provider_row(
            "Google Cloud Platform (GCP)",
            "gcloud, kubectl, terraform",
            False
        )
        self.azure_check = self._create_provider_row(
            "Microsoft Azure",
            "az, kubectl, terraform",
            False
        )
        self.k8s_check = self._create_provider_row(
            "Kubernetes Only",
            "kubectl, helm, k9s",
            False
        )

        self.append(self.providers_box)

        # Info box
        info_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        info_box.set_margin_top(24)
        info_box.set_halign(Gtk.Align.CENTER)
        info_box.add_css_class("dim-label")

        info_icon = Gtk.Image.new_from_icon_name("dialog-information-symbolic")
        info_box.append(info_icon)

        info_label = Gtk.Label(
            label="All CLI tools are pre-installed. This just sets up shell integration."
        )
        info_label.set_wrap(True)
        info_box.append(info_label)

        self.append(info_box)

    def _create_provider_row(self, name, tools, default_active):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.set_size_request(400, -1)

        check = Gtk.CheckButton()
        check.set_active(default_active)
        row.append(check)

        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)

        name_label = Gtk.Label(label=name)
        name_label.set_halign(Gtk.Align.START)
        name_label.add_css_class("heading")
        text_box.append(name_label)

        tools_label = Gtk.Label(label=tools)
        tools_label.set_halign(Gtk.Align.START)
        tools_label.add_css_class("dim-label")
        tools_label.add_css_class("caption")
        text_box.append(tools_label)

        row.append(text_box)

        self.providers_box.append(row)
        return check

    def get_selected_providers(self):
        """Returns list of selected cloud providers"""
        providers = []
        if self.aws_check.get_active():
            providers.append("aws")
        if self.gcp_check.get_active():
            providers.append("gcp")
        if self.azure_check.get_active():
            providers.append("azure")
        if self.k8s_check.get_active():
            providers.append("k8s")
        return providers


class CredentialSetupPage(Gtk.Box):
    """Credential manager setup page"""

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        self.set_margin_top(32)
        self.set_margin_bottom(32)
        self.set_margin_start(48)
        self.set_margin_end(48)

        # Title
        title = Gtk.Label(label="Credential Security")
        title.add_css_class("title-2")
        self.append(title)

        # Description
        desc = Gtk.Label(
            label="NubiferOS uses GPG-encrypted credential storage.\n"
                  "Your credentials are never stored in plain text."
        )
        desc.set_wrap(True)
        desc.set_justify(Gtk.Justification.CENTER)
        desc.add_css_class("dim-label")
        self.append(desc)

        # Status check
        self.status_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.status_box.set_margin_top(24)
        self.status_box.set_halign(Gtk.Align.CENTER)

        self.gpg_status = self._create_status_row("GPG Key", "checking...")
        self.pass_status = self._create_status_row("Password Store", "checking...")

        self.append(self.status_box)

        # Button box for setup and refresh
        button_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        button_box.set_halign(Gtk.Align.CENTER)
        button_box.set_margin_top(24)

        # Setup button
        self.setup_button = Gtk.Button(label="Set Up Credential Manager")
        self.setup_button.add_css_class("pill")
        self.setup_button.add_css_class("suggested-action")
        self.setup_button.connect("clicked", self._on_setup_clicked)
        button_box.append(self.setup_button)

        # Refresh button
        self.refresh_button = Gtk.Button()
        self.refresh_button.set_icon_name("view-refresh-symbolic")
        self.refresh_button.set_tooltip_text("Refresh status")
        self.refresh_button.add_css_class("circular")
        self.refresh_button.connect("clicked", self._on_refresh_clicked)
        button_box.append(self.refresh_button)

        self.append(button_box)

        # Check status on creation
        GLib.timeout_add(500, self._check_status)

    def _create_status_row(self, name, status):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.set_size_request(300, -1)

        name_label = Gtk.Label(label=name)
        name_label.set_halign(Gtk.Align.START)
        name_label.set_hexpand(True)
        row.append(name_label)

        status_label = Gtk.Label(label=status)
        status_label.set_halign(Gtk.Align.END)
        status_label.add_css_class("dim-label")
        row.append(status_label)

        self.status_box.append(row)
        return status_label

    def _on_refresh_clicked(self, button):
        """Handle refresh button click"""
        self.gpg_status.set_label("checking...")
        self.pass_status.set_label("checking...")
        GLib.timeout_add(100, self._check_status)

    def _check_status(self):
        """Check GPG and pass status"""
        # Check GPG
        try:
            result = subprocess.run(
                ["gpg", "--list-keys"],
                capture_output=True, text=True
            )
            if "pub" in result.stdout:
                self.gpg_status.set_label("Configured ✓")
                self.gpg_status.remove_css_class("error")
                self.gpg_status.add_css_class("success")
            else:
                self.gpg_status.set_label("Not set up")
                self.gpg_status.remove_css_class("success")
                self.gpg_status.add_css_class("error")
        except Exception:
            self.gpg_status.set_label("Not available")
            self.gpg_status.remove_css_class("success")
            self.gpg_status.add_css_class("error")

        # Check pass
        pass_dir = os.path.expanduser("~/.password-store")
        if os.path.exists(os.path.join(pass_dir, ".gpg-id")):
            self.pass_status.set_label("Initialized ✓")
            self.pass_status.remove_css_class("error")
            self.pass_status.add_css_class("success")
            self.setup_button.set_label("Re-run Setup Wizard")
            self.setup_button.remove_css_class("suggested-action")
        else:
            self.pass_status.set_label("Not initialized")
            self.pass_status.remove_css_class("success")
            self.pass_status.add_css_class("error")

        return False  # Don't repeat

    def _on_setup_clicked(self, button):
        """Launch terminal setup wizard"""
        try:
            subprocess.Popen([
                "gnome-terminal",
                "--",
                "bash", "-c",
                "nubifer-setup-wizard setup; echo; echo 'Press Enter to close...'; read"
            ])
        except Exception as e:
            print(f"Failed to launch terminal: {e}")


