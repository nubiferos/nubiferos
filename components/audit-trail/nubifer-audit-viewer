#!/usr/bin/env python3
"""
NubiferOS Audit Trail Viewer
GTK3 application for viewing and filtering cloud CLI command history.
"""

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib, Gdk, Pango
import sqlite3
import os
import json
import csv
import io
from pathlib import Path
from datetime import datetime, timedelta


AUDIT_DB = Path.home() / ".local" / "share" / "nubifer" / "audit" / "commands.db"

# Provider display info
PROVIDER_COLORS = {
    "aws": "#FF9900",
    "azure": "#0078D4",
    "gcp": "#4285F4",
    "oracle": "#F80000",
    "terraform": "#7B42BC",
}

OUTCOME_COLORS = {
    "allowed": "#4CAF50",
    "blocked": "#F44336",
    "no_workspace": "#FF9800",
}


class AuditViewer(Gtk.Window):
    def __init__(self):
        super().__init__(title="NubiferOS Audit Trail")
        self.set_default_size(1100, 700)
        self.set_border_width(0)

        self._apply_css()

        # Main layout
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(main_box)

        # Header bar
        header = self._build_header()
        main_box.pack_start(header, False, False, 0)

        # Filter bar
        filter_bar = self._build_filter_bar()
        main_box.pack_start(filter_bar, False, False, 0)

        # Stats bar
        self.stats_bar = Gtk.Label()
        self.stats_bar.set_halign(Gtk.Align.START)
        self.stats_bar.set_margin_start(12)
        self.stats_bar.set_margin_top(4)
        self.stats_bar.set_margin_bottom(4)
        self.stats_bar.get_style_context().add_class("stats-bar")
        main_box.pack_start(self.stats_bar, False, False, 0)

        # Command list (TreeView in ScrolledWindow)
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_vexpand(True)

        self.liststore = Gtk.ListStore(
            str,  # 0: timestamp
            str,  # 1: provider
            str,  # 2: workspace
            str,  # 3: command + args
            str,  # 4: credential hint
            str,  # 5: outcome
            str,  # 6: user
            str,  # 7: account
            str,  # 8: full args (for detail panel)
            int,  # 9: row id
        )

        self.treeview = Gtk.TreeView(model=self.liststore)
        self.treeview.set_headers_clickable(True)
        self.treeview.set_enable_search(True)
        self.treeview.set_search_column(3)
        self.treeview.get_style_context().add_class("audit-table")

        # Selection handler for detail panel
        self.treeview.get_selection().connect("changed", self._on_selection_changed)

        columns = [
            ("Time", 0, 170),
            ("Provider", 1, 80),
            ("Workspace", 2, 140),
            ("Command", 3, 350),
            ("Credential", 4, 80),
            ("Status", 5, 80),
            ("User", 6, 80),
        ]

        for title, col_idx, width in columns:
            renderer = Gtk.CellRendererText()
            renderer.set_property("ellipsize", Pango.EllipsizeMode.END)

            if col_idx == 5:  # outcome column - custom rendering
                col = Gtk.TreeViewColumn(title, renderer, text=col_idx)
                col.set_cell_data_func(renderer, self._render_outcome)
            elif col_idx == 1:  # provider column
                col = Gtk.TreeViewColumn(title, renderer, text=col_idx)
                col.set_cell_data_func(renderer, self._render_provider)
            else:
                col = Gtk.TreeViewColumn(title, renderer, text=col_idx)

            col.set_resizable(True)
            col.set_min_width(60)
            col.set_fixed_width(width)
            col.set_sort_column_id(col_idx)
            self.treeview.append_column(col)

        scrolled.add(self.treeview)

        # Paned: list on top, detail on bottom
        paned = Gtk.Paned(orientation=Gtk.Orientation.VERTICAL)
        paned.pack1(scrolled, resize=True, shrink=False)

        # Detail panel
        detail_scroll = Gtk.ScrolledWindow()
        detail_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        detail_scroll.set_min_content_height(200)

        self.detail_label = Gtk.Label()
        self.detail_label.set_halign(Gtk.Align.START)
        self.detail_label.set_valign(Gtk.Align.START)
        self.detail_label.set_selectable(True)
        self.detail_label.set_line_wrap(True)
        self.detail_label.set_margin_start(12)
        self.detail_label.set_margin_top(8)
        self.detail_label.set_margin_end(12)
        self.detail_label.set_margin_bottom(8)
        self.detail_label.get_style_context().add_class("detail-panel")
        self.detail_label.set_markup("<i>Select a command to see details</i>")
        detail_scroll.add(self.detail_label)

        paned.pack2(detail_scroll, resize=False, shrink=False)
        paned.set_position(400)

        main_box.pack_start(paned, True, True, 0)

        # Load data
        self._load_data()

