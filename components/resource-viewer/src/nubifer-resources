#!/usr/bin/env python3
"""
NubiferOS Resource Viewer - GTK3 browser

Browses the local cloud resource inventory (see db.py) and triggers syncs
via the AWS indexer (see indexer.py). The UI always renders from the local
SQLite database, so it works fully offline - a sync only refreshes the
cache.

Design notes:
- The tree groups resources provider > service > resource. Search filters
  the tree live on name, native ID, and type.
- Sync runs the indexer in a daemon thread; all UI updates are marshalled
  back to the GTK main loop with GLib.idle_add.
- A failed sync (no network, no credentials, missing IAM permissions)
  never clears the view: cached data stays visible and a dismissible
  warning bar explains what happened. This is deliberate - stale-but-
  labelled data beats an empty screen in an outage.
"""

import json
import os
import sys
import threading
from datetime import datetime, timezone

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib, Gdk, Pango

# db.py and indexer.py are installed alongside this script
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from db import ResourceDB          # noqa: E402
from indexer import ResourceIndexer  # noqa: E402

# TreeStore columns
COL_NAME = 0      # display name (resource name, or group label)
COL_TYPE = 1      # resource type (empty for group rows)
COL_ID = 2        # database primary key (empty for group rows)
COL_HAYSTACK = 3  # lowercase "name id type" used for live search

PROVIDER_LABELS = {"aws": "AWS"}
SERVICE_LABELS = {
    "ec2": "EC2",
    "s3": "S3",
    "lambda": "Lambda",
    "rds": "RDS",
    "vpc": "VPC",
}

# Fetch effectively everything; the DB API defaults to 500 rows
LIST_LIMIT = 100000


class ResourceViewer(Gtk.Window):
    """Main window: resource tree + detail pane + sync controls."""

    def __init__(self):
        super().__init__(title="NubiferOS Resource Viewer")
        self.set_default_size(1050, 700)

        self.db = ResourceDB()
        self._syncing = False
        self._search_term = ""

        self._apply_css()

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(main_box)

        main_box.pack_start(self._create_header(), False, False, 0)
        main_box.pack_start(self._create_cached_banner(), False, False, 0)
        main_box.pack_start(self._create_warning_bar(), False, False, 0)

        # Stack: empty state (no inventory yet) vs. the browser panes
        self._stack = Gtk.Stack()
        self._stack.add_named(self._create_empty_state(), "empty")
        self._stack.add_named(self._create_browser(), "browser")
        main_box.pack_start(self._stack, True, True, 0)

        self._reload()
        self.show_all()

    # ==================== Styling ====================

