  "outputs": {
    "deployment_instructions": {
      "value": "    \n✅ Infrastructure deployed successfully!\n    \nNext steps:\n1. Upload ISO to S3:\n   aws s3 cp output/nubiferos-1.0-amd64.iso s3://nubiferos-iso-builds/nubiferos-latest.iso\n    \n2. Monitor pipeline:\n   aws codepipeline get-pipeline-state --name nubiferos-test-pipeline\n    \n3. View logs:\n   aws logs tail /aws/codebuild/nubiferos-import-iso --follow\n    \n4. After deployment, connect to instance:\n   - Get IP: aws ec2 describe-instances --filters \"Name=tag:Purpose,Values=nubiferos-test\"\n   - URL: https://\u003cinstance-ip\u003e:8443\n   - User: live / Pass: live\n",
      "type": "string"
    },
    "iso_bucket_name": {
      "value": "nubiferos-iso-builds",
      "type": "string"
    },
    "pipeline_name": {
      "value": "nubiferos-test-pipeline",
      "type": "string"
    },
    "security_group_id": {
