---
componentName:  nubiferos

# PHASE 1: Minimal branding - strings only
strings:
    productName:         "NubiferOS"
    shortProductName:    "NubiferOS"
    version:             "1.0"
    shortVersion:        "1.0"
    versionedName:       "NubiferOS 1.0"
    shortVersionedName:  "NubiferOS 1.0"
    bootloaderEntryName: "NubiferOS"
    productUrl:          "https://nubiferos.io"
    supportUrl:          "https://github.com/nubiferos/nubiferos"
    knownIssuesUrl:      "https://github.com/nubiferos/nubiferos/issues"
    releaseNotesUrl:     "https://github.com/nubiferos/nubiferos/releases"
    
    # Welcome screen text
    welcomeStyleCalamares:   false
    welcomeExpandingLogo:    true
    
    # Installation messages (shown during exec phase)
    installationMessage:     "Installing NubiferOS - The Cloud Engineer's Workstation"
    installationDescription: "Setting up secure workspace isolation, credential management, and cloud tools..."

# Override the welcome page text to remove "live CD" references
# This replaces the default "This program will install..." text
welcomeText:
    en: |
        <h1>Welcome to NubiferOS</h1>
        <p>This installer will guide you through installing NubiferOS on your computer.</p>
        <p>NubiferOS is a secure workstation for cloud engineers with built-in credential management and workspace isolation.</p>
        <p><strong>Important:</strong> Full disk encryption is required for security.</p>

# PHASE 2: Images
images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

# PHASE 3: Slideshow - Simple text-based slideshow (no complex animations)
slideshow:              "show.qml"
slideshowAPI:           2

# PHASE 4: Stylesheet
stylesheet:             "stylesheet.qss"

# PHASE 5: Window settings
windowExpanding:        fullscreen
windowPlacement:        center
windowSize:             800px,520px

# PHASE 6: Panel settings
sidebar:
    side: left
    widget: true
navigation:
    side: bottom
    widget: true

# PHASE 7: Style colors
style:
   sidebarBackground:    "#2c3e50"
   sidebarText:          "#ffffff"
   sidebarTextSelect:    "#3498db"
   sidebarTextHighlight: "#3498db"
