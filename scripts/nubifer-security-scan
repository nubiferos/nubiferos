#!/usr/bin/env python3
"""
NubiferOS Local Security Scanner
Run security scans on the local system or ISO files.
"""

import argparse
import subprocess
import sys
import os
import json
import tempfile
from pathlib import Path
from datetime import datetime

# ANSI colors
GREEN = '\033[92m'
YELLOW = '\033[93m'
RED = '\033[91m'
CYAN = '\033[96m'
RESET = '\033[0m'
BOLD = '\033[1m'

RESULTS_DIR = Path.home() / ".local/share/nubifer/security"
SCRIPTS_DIR = Path("/usr/share/nubiferos/security") if Path("/usr/share/nubiferos/security").exists() else Path(__file__).parent / "security"


def log(msg, level="info", quiet=False):
    """Print colored log message."""
    if quiet and level != "error":
        return
    
    colors = {
        "info": CYAN,
        "success": GREEN,
        "warning": YELLOW,
        "error": RED
    }
    color = colors.get(level, "")
    print(f"{color}{msg}{RESET}")


def run_cmd(cmd, capture=True, check=False):
    """Run a shell command."""
    try:
        result = subprocess.run(
            cmd, shell=True, capture_output=capture, text=True,
            timeout=300  # 5 minute timeout
        )
        if check and result.returncode != 0:
            return None
        return result
    except subprocess.TimeoutExpired:
        return None
    except Exception as e:
        return None


def check_tool(tool):
    """Check if a tool is installed."""
    result = run_cmd(f"which {tool}", check=True)
    return result is not None and result.returncode == 0


def install_tool(tool, install_cmd, quiet=False):
    """Install a tool if not present."""
    if check_tool(tool):
        return True
    
    log(f"Installing {tool}...", quiet=quiet)
    result = run_cmd(install_cmd)
    return result is not None and result.returncode == 0


def vuln_scan(target=None, output_json=False, quiet=False):
    """Run vulnerability scan on the system or a target."""
    log(f"\n{BOLD}🔍 Running Vulnerability Scan{RESET}", quiet=quiet)
    
    # Ensure grype is installed
    if not check_tool("grype"):
        log("Installing grype...", quiet=quiet)
        run_cmd("curl -sSfL https://raw.githubusercontent.com/anchore/grype/main/install.sh | sudo sh -s -- -b /usr/local/bin")
    
    if not check_tool("grype"):
        log("Failed to install grype", "error")
        return {"error": "grype not available"}
    
    # Determine scan target
    if target:
        scan_target = target
    else:
        scan_target = "dir:/"
    
    # Run scan
    log(f"Scanning: {scan_target}", quiet=quiet)
    
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        json_file = f.name
    
    result = run_cmd(f"grype {scan_target} -o json > {json_file} 2>/dev/null")
    
    # Parse results
    try:
        with open(json_file) as f:
            data = json.load(f)
        os.unlink(json_file)
    except:
        os.unlink(json_file)
        return {"error": "Failed to parse scan results"}
    
    # Count by severity
    matches = data.get("matches", [])
    counts = {"Critical": 0, "High": 0, "Medium": 0, "Low": 0, "Negligible": 0}
    
    for match in matches:
        severity = match.get("vulnerability", {}).get("severity", "Unknown")
        if severity in counts:
            counts[severity] += 1
    
    results = {
        "timestamp": datetime.now().isoformat(),
        "target": scan_target,
        "total": len(matches),
        "by_severity": counts,
        "vulnerabilities": matches[:20] if not output_json else matches  # Limit for display
    }
    
    # Save results
    RESULTS_DIR.mkdir(parents=True, exist_ok=True)
    results_file = RESULTS_DIR / "vuln-scan.json"
    with open(results_file, 'w') as f:
        json.dump(results, f, indent=2)
    
    if not quiet:
        log(f"\n{BOLD}Vulnerability Summary:{RESET}")
        log(f"  Critical: {RED}{counts['Critical']}{RESET}")
        log(f"  High:     {YELLOW}{counts['High']}{RESET}")
        log(f"  Medium:   {CYAN}{counts['Medium']}{RESET}")
        log(f"  Low:      {counts['Low']}")
        log(f"\nResults saved to: {results_file}")
    
    if output_json:
        print(json.dumps(results, indent=2))
    
    return results


def compliance_check(quiet=False, output_json=False):
    """Run compliance/hardening check using lynis."""
    log(f"\n{BOLD}🛡️ Running Compliance Check{RESET}", quiet=quiet)
    
    # Ensure lynis is installed
    if not check_tool("lynis"):
        log("Installing lynis...", quiet=quiet)
        run_cmd("sudo apt-get install -y lynis")
    
    if not check_tool("lynis"):
        log("Failed to install lynis", "error")
        return {"error": "lynis not available"}
    
    # Run audit
    log("Running system audit (this may take a few minutes)...", quiet=quiet)
    
    with tempfile.NamedTemporaryFile(mode='w', suffix='.log', delete=False) as f:
        log_file = f.name
    
    result = run_cmd(f"sudo lynis audit system --quick --no-colors > {log_file} 2>&1")
    
    # Parse results
    score = 0
    warnings = []
    suggestions = []
    
    try:
        with open(log_file) as f:
            content = f.read()
        
        for line in content.split('\n'):
            if 'Hardening index' in line:
                # Extract score like "Hardening index : 67 [#############       ]"
                parts = line.split(':')
                if len(parts) > 1:
                    score_part = parts[1].strip().split()[0]
                    try:
                        score = int(score_part)
                    except:
                        pass
            elif line.strip().startswith('- ') and 'warning' in line.lower():
                warnings.append(line.strip()[2:])
            elif line.strip().startswith('- ') and 'suggestion' in line.lower():
                suggestions.append(line.strip()[2:])
        
        os.unlink(log_file)
    except:
        if os.path.exists(log_file):
            os.unlink(log_file)
    
    results = {
        "timestamp": datetime.now().isoformat(),
        "hardening_score": score,
        "warnings_count": len(warnings),
        "suggestions_count": len(suggestions),
        "warnings": warnings[:10],
        "suggestions": suggestions[:10]
    }
    
    # Save results
    RESULTS_DIR.mkdir(parents=True, exist_ok=True)
    results_file = RESULTS_DIR / "compliance.json"
    with open(results_file, 'w') as f:
        json.dump(results, f, indent=2)
    
    if not quiet:
        if score >= 80:
            color = GREEN
            status = "Excellent"
        elif score >= 60:
            color = YELLOW
            status = "Good"
        else:
            color = RED
            status = "Needs Improvement"
        
        log(f"\n{BOLD}Hardening Score: {color}{score}/100{RESET} ({status})")
        log(f"  Warnings: {len(warnings)}")
        log(f"  Suggestions: {len(suggestions)}")
        log(f"\nResults saved to: {results_file}")
    
    if output_json:
        print(json.dumps(results, indent=2))
    
    return results


def verify_iso(iso_path, quiet=False, output_json=False):
    """Verify ISO signature."""
    log(f"\n{BOLD}🔐 Verifying ISO Signature{RESET}", quiet=quiet)
    
    iso_path = Path(iso_path)
    if not iso_path.exists():
        log(f"ISO not found: {iso_path}", "error")
        return {"error": "ISO not found", "valid": False}
    
    sig_path = iso_path.with_suffix(iso_path.suffix + ".asc")
    if not sig_path.exists():
        # Try alternate location
        sig_path = iso_path.parent / (iso_path.name + ".asc")
    
    if not sig_path.exists():
        log(f"Signature file not found: {sig_path}", "error")
        return {"error": "Signature not found", "valid": False}
    
    # Import public key if not already imported
    pub_key = Path("/usr/share/nubifer/nubiferos-signing-key.pub")
    if not pub_key.exists():
        pub_key = Path("security/nubiferos-release-signing.pub")
    
    if pub_key.exists():
        run_cmd(f"gpg --import {pub_key} 2>/dev/null")
    
    # Verify signature
    result = run_cmd(f"gpg --verify {sig_path} {iso_path} 2>&1")
    
    valid = result is not None and "Good signature" in result.stdout
    
    results = {
        "timestamp": datetime.now().isoformat(),
        "iso": str(iso_path),
        "signature": str(sig_path),
        "valid": valid,
        "output": result.stdout if result else "Verification failed"
    }
    
    if not quiet:
        if valid:
            log(f"\n{GREEN}✓ Signature valid{RESET}")
        else:
            log(f"\n{RED}✗ Signature invalid or verification failed{RESET}")
            if result:
                log(result.stdout)
    
    if output_json:
        print(json.dumps(results, indent=2))
    
    return results


def full_scan(quiet=False, output_json=False):
    """Run all security scans."""
    log(f"\n{BOLD}🔒 Running Full Security Scan{RESET}", quiet=quiet)
    
    results = {
        "timestamp": datetime.now().isoformat(),
        "scans": {}
    }
    
    # Vulnerability scan
    results["scans"]["vulnerabilities"] = vuln_scan(quiet=quiet)
    
    # Compliance check
    results["scans"]["compliance"] = compliance_check(quiet=quiet)
    
    # Summary
    if not quiet:
        log(f"\n{BOLD}{'='*50}{RESET}")
        log(f"{BOLD}Security Scan Complete{RESET}")
        log(f"{'='*50}")
        
        vuln = results["scans"]["vulnerabilities"]
        comp = results["scans"]["compliance"]
        
        if "error" not in vuln:
            critical = vuln["by_severity"]["Critical"]
            high = vuln["by_severity"]["High"]
            if critical > 0:
                log(f"  Vulnerabilities: {RED}⚠ {critical} Critical{RESET}")
            elif high > 0:
                log(f"  Vulnerabilities: {YELLOW}⚠ {high} High{RESET}")
            else:
                log(f"  Vulnerabilities: {GREEN}✓ No critical issues{RESET}")
        
        if "error" not in comp:
            score = comp["hardening_score"]
            if score >= 80:
                log(f"  Hardening: {GREEN}✓ Score {score}/100{RESET}")
            elif score >= 60:
                log(f"  Hardening: {YELLOW}⚠ Score {score}/100{RESET}")
            else:
                log(f"  Hardening: {RED}✗ Score {score}/100{RESET}")
        
        log(f"\nResults saved to: {RESULTS_DIR}")
    
    # Save combined results
    RESULTS_DIR.mkdir(parents=True, exist_ok=True)
    with open(RESULTS_DIR / "full-scan.json", 'w') as f:
        json.dump(results, f, indent=2)
    
    if output_json:
        print(json.dumps(results, indent=2))
    
    return results


def main():
    parser = argparse.ArgumentParser(
        description="NubiferOS Security Scanner - Check for vulnerabilities and audit system hardening",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Scan Types:
  --vuln-scan     Scan installed packages for known CVEs using grype
  --compliance    Audit system hardening using lynis (score 0-100)
  --verify-iso    Verify GPG signature of an ISO file
  --full          Run all scans (vuln-scan + compliance)

Output:
  Results are saved to ~/.local/share/nubifer/security/ as JSON files.
  Use --json to output results to stdout for scripting.
  View results in the NubiferOS Security Dashboard.

Examples:
  nubifer-security-scan --vuln-scan          # Scan for vulnerabilities
  nubifer-security-scan --compliance         # Run hardening audit
  nubifer-security-scan --verify-iso file.iso  # Verify ISO signature
  nubifer-security-scan --full               # Run all scans
  nubifer-security-scan --full --json        # Output as JSON

Exit Codes:
  0  Success
  2  Critical vulnerabilities found

See also: man nubifer-security-scan
        """
    )
    
    parser.add_argument("--vuln-scan", action="store_true",
                        help="Run vulnerability scan on the system")
    parser.add_argument("--compliance", action="store_true",
                        help="Run compliance/hardening check")
    parser.add_argument("--verify-iso", metavar="ISO",
                        help="Verify ISO signature")
    parser.add_argument("--full", action="store_true",
                        help="Run all security scans")
    parser.add_argument("--json", action="store_true",
                        help="Output results as JSON")
    parser.add_argument("--quiet", "-q", action="store_true",
                        help="Suppress non-essential output")
    parser.add_argument("--target", metavar="PATH",
                        help="Target path for vulnerability scan")
    
    args = parser.parse_args()
    
    # Default to showing help if no options
    if not any([args.vuln_scan, args.compliance, args.verify_iso, args.full]):
        parser.print_help()
        sys.exit(0)
    
    results = {}
    
    if args.full:
        results = full_scan(quiet=args.quiet, output_json=args.json)
    else:
        if args.vuln_scan:
            results["vulnerabilities"] = vuln_scan(
                target=args.target, 
                output_json=args.json, 
                quiet=args.quiet
            )
        
        if args.compliance:
            results["compliance"] = compliance_check(
                quiet=args.quiet, 
                output_json=args.json
            )
        
        if args.verify_iso:
            results["iso_verification"] = verify_iso(
                args.verify_iso, 
                quiet=args.quiet, 
                output_json=args.json
            )
    
    # Exit code based on results
    if args.vuln_scan or args.full:
        vuln = results.get("vulnerabilities", results.get("scans", {}).get("vulnerabilities", {}))
        if vuln.get("by_severity", {}).get("Critical", 0) > 0:
            sys.exit(2)  # Critical vulnerabilities
    
    sys.exit(0)


if __name__ == "__main__":
    main()
